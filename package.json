{
  "name": "rustophile",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.10.1",
  "description": "Rustophile: learning Rust in public.",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustophile/blog.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:clean": "node -e \"for (const d of ['.astro','node_modules/.astro','dist']) require('node:fs').rmSync(d,{recursive:true,force:true})\" && astro build",
    "preview": "astro preview",
    "check": "pnpm check:astro && pnpm check:svelte",
    "check:astro": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "qa": "pnpm check && astro build",
    "astro": "astro",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "og-image": "node --experimental-strip-types scripts/og-image.ts",
    "preview:cf": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.52.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "hast-util-to-string": "^3.0.1",
    "photoswipe": "^5.4.4",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "shadcn-svelte": "^1.7.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "mdast-util-to-hast": "^13.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-expressive-code": "0.44.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.148.0"
  }
}
