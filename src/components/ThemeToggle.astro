---
// Theme picker: Warm Paper, std Dark, or follow the OS. The choice is stored as
// "rustophile_theme"; BaseLayout's inline script applies it before first paint.

const themes = [
  { value: "paper", icon: "📜", label: "Warm Paper" },
  { value: "dark", icon: "🌙", label: "std Dark" },
  { value: "auto", icon: "💻", label: "System" },
];

// shared by the options and their check marks
const option =
  "theme-option group flex w-full cursor-pointer items-center justify-between gap-2 rounded-[5px] border-none bg-transparent px-[0.65rem] py-[0.45rem] text-left font-sans text-[0.84rem] text-foreground transition-[background-color,color] duration-[120ms] ease-[ease] hover:bg-muted hover:text-link aria-checked:bg-muted aria-checked:font-semibold aria-checked:text-link";
const check = "hidden shrink-0 text-link group-aria-checked:block";
---

<div class="relative inline-flex items-center" id="theme-selector">
  <button
    id="theme-toggle-btn"
    class="group inline-flex size-[34px] cursor-pointer items-center justify-center gap-[3px] rounded-[6px] border border-border bg-card p-0 text-muted-foreground transition-[color,background-color,border-color,transform] duration-150 ease-[ease] hover:border-link hover:bg-muted hover:text-foreground"
    aria-label="Select color theme"
    aria-haspopup="true"
    aria-expanded="false"
    title="Color theme"
  >
    <span
      id="theme-active-icon"
      class="inline-flex items-center justify-center text-[1rem] leading-none"
    >
      💻
    </span>
    <svg
      class="-ml-px opacity-60 transition-transform duration-150 ease-[ease] group-aria-expanded:rotate-180"
      width="9"
      height="9"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Floating Theme Dropdown -->
  <div
    id="theme-dropdown"
    class="theme-dropdown absolute top-[calc(100%+6px)] right-0 z-[1000] hidden min-w-[175px] animate-[themeDropdownFade_0.15s_ease] rounded-[8px] border border-border bg-background p-[0.35rem] shadow-[0_10px_25px_-5px_rgba(0,0,0,0.2)] backdrop-blur-[12px] max-md:right-auto max-md:left-1/2 max-md:max-w-[calc(100vw-24px)] max-md:[transform:translateX(-50%)] [&.open]:block"
    role="menu"
    aria-label="Available themes"
  >
    <div class="px-[0.65rem] pt-[0.25rem] pb-[0.35rem] font-mono text-[0.68rem] font-bold tracking-[0.06em] text-muted-foreground opacity-80">
      THEME
    </div>

    {themes.map(({ value, icon, label }) => (
      <>
        {value === "auto" && <div class="my-[0.3rem] h-px bg-border" />}
        <button
          class={option}
          data-theme-val={value}
          role="menuitemradio"
          aria-checked="false"
        >
          <span class="inline-flex items-center gap-[0.55rem]">
            <span
              class="inline-flex w-[18px] items-center justify-center text-[0.95rem] leading-none"
              aria-hidden="true"
            >
              {icon}
            </span>
            <span class="font-medium">{label}</span>
          </span>
          <svg
            class={check}
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </button>
      </>
    ))}
  </div>
</div>

<style>
  /* keyframes have no utility form; referenced by the dropdown's arbitrary animate class */
  @keyframes themeDropdownFade {
    from {
      opacity: 0;
      margin-top: -4px;
    }
    to {
      opacity: 1;
      margin-top: 0;
    }
  }
</style>

<script>
  const STORAGE_KEY = "rustophile_theme";
  const ICONS: Record<string, string> = { paper: "📜", dark: "🌙", auto: "💻" };
  const THEME_COLORS: Record<string, string> = {
    paper: "#f7f4ea",
    dark: "#353535",
  };
  const osDark = window.matchMedia("(prefers-color-scheme: dark)");

  const btn = document.getElementById("theme-toggle-btn");
  const dropdown = document.getElementById("theme-dropdown");
  const selector = document.getElementById("theme-selector");
  const activeIcon = document.getElementById("theme-active-icon");
  const options = document.querySelectorAll<HTMLButtonElement>(".theme-option");

  function storedMode(): string {
    try {
      return localStorage.getItem(STORAGE_KEY) || "auto";
    } catch {
      return "auto";
    }
  }

  function effectiveTheme(mode: string): string {
    if (mode === "auto") return osDark.matches ? "dark" : "paper";
    return mode;
  }

  function render(mode: string) {
    const theme = effectiveTheme(mode);
    document.documentElement.setAttribute("data-theme", theme);
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", THEME_COLORS[theme]);
    if (activeIcon) activeIcon.textContent = ICONS[mode] ?? ICONS.auto;
    options.forEach((opt) =>
      opt.setAttribute(
        "aria-checked",
        String(opt.getAttribute("data-theme-val") === mode),
      ),
    );
    // lets embedded widgets (comments) follow the theme
    window.dispatchEvent(
      new CustomEvent("rustophile-theme-change", { detail: { theme, mode } }),
    );
  }

  function choose(mode: string) {
    try {
      localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      // storage blocked: the choice lasts for this page only
    }
    render(mode);
  }

  function setOpen(open: boolean) {
    dropdown?.classList.toggle("open", open);
    btn?.setAttribute("aria-expanded", String(open));
    if (open) positionDropdown();
  }

  // on phones the menu is centred under the button, then nudged back inside the viewport
  function positionDropdown() {
    if (!dropdown) return;
    if (window.innerWidth <= 768) {
      dropdown.style.left = "50%";
      dropdown.style.right = "auto";
      dropdown.style.transform = "translateX(-50%)";

      const rect = dropdown.getBoundingClientRect();
      const pad = 12;
      if (rect.left < pad) {
        const offset = pad - rect.left;
        dropdown.style.transform = `translateX(calc(-50% + ${offset}px))`;
      } else if (rect.right > window.innerWidth - pad) {
        const offset = rect.right - (window.innerWidth - pad);
        dropdown.style.transform = `translateX(calc(-50% - ${offset}px))`;
      }
    } else {
      dropdown.style.left = "";
      dropdown.style.right = "";
      dropdown.style.transform = "";
    }
  }

  render(storedMode());

  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    // one header menu open at a time
    document
      .querySelectorAll(".social-dropdown-menu.open")
      .forEach((d) => d.classList.remove("open"));
    document
      .getElementById("social-menu-btn")
      ?.setAttribute("aria-expanded", "false");
    setOpen(!dropdown?.classList.contains("open"));
  });

  options.forEach((opt) =>
    opt.addEventListener("click", () => {
      const mode = opt.getAttribute("data-theme-val");
      if (!mode) return;
      setOpen(false);
      choose(mode);
    }),
  );

  window.addEventListener("resize", () => {
    if (dropdown?.classList.contains("open")) positionDropdown();
  });

  document.addEventListener("click", (e) => {
    if (!selector?.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && dropdown?.classList.contains("open")) {
      setOpen(false);
      btn?.focus();
    }
  });

  osDark.addEventListener("change", () => {
    if (storedMode() === "auto") render("auto");
  });
</script>
