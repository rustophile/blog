---
// src/components/ThemeToggle.astro
// Dropdown menu for Minrock themes (Clean White, Warm Paper, Slate Navy, Midnight OLED, Auto)

// shared by the five options and their check marks
const option =
  "theme-option group flex w-full cursor-pointer items-center justify-between gap-2 rounded-[5px] border-none bg-transparent px-[0.65rem] py-[0.45rem] text-left font-sans text-[0.84rem] text-fg transition-[background-color,color] duration-[120ms] ease-[ease] hover:bg-subtle hover:text-accent [&.active]:bg-subtle [&.active]:font-semibold [&.active]:text-accent";
const check = "hidden shrink-0 text-accent group-[.active]:block";
---

<div class="relative inline-flex items-center" id="theme-selector">
  <button
    id="theme-toggle-btn"
    class="group inline-flex size-[34px] cursor-pointer items-center justify-center gap-[3px] rounded-[6px] border border-line bg-surface p-0 text-muted transition-[color,background-color,border-color,transform] duration-150 ease-[ease] hover:border-accent hover:bg-subtle hover:text-fg"
    aria-label="Select color theme"
    aria-haspopup="true"
    aria-expanded="false"
    title="Color theme / Tema visual"
  >
    <span
      id="theme-active-icon"
      class="inline-flex items-center justify-center text-[1rem] leading-none"
    >
      📜
    </span>
    <svg
      class="-ml-px opacity-60 transition-transform duration-150 ease-[ease] group-aria-expanded:rotate-180"
      width="9"
      height="9"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Floating Theme Dropdown -->
  <div
    id="theme-dropdown"
    class="theme-dropdown absolute top-[calc(100%+6px)] right-0 z-[1000] hidden min-w-[175px] animate-[themeDropdownFade_0.15s_ease] rounded-[8px] border border-line bg-page p-[0.35rem] shadow-[0_10px_25px_-5px_rgba(0,0,0,0.2)] backdrop-blur-[12px] max-md:right-auto max-md:left-1/2 max-md:max-w-[calc(100vw-24px)] max-md:[transform:translateX(-50%)] [&.open]:block"
    role="menu"
    aria-label="Available themes"
  >
    <div class="px-[0.65rem] pt-[0.25rem] pb-[0.35rem] font-mono text-[0.68rem] font-bold tracking-[0.06em] text-muted opacity-80">
      THEME
    </div>

    <button class={option} data-theme-val="white" role="menuitem">
      <span class="inline-flex items-center gap-[0.55rem]">
        <span class="inline-flex w-[18px] items-center justify-center text-[0.95rem] leading-none">
          ☀️
        </span>
        <span class="font-medium">Clean White</span>
      </span>
      <svg
        class={check}
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>

    <button class={option} data-theme-val="cream" role="menuitem">
      <span class="inline-flex items-center gap-[0.55rem]">
        <span class="inline-flex w-[18px] items-center justify-center text-[0.95rem] leading-none">
          📜
        </span>
        <span class="font-medium">Warm Paper</span>
      </span>
      <svg
        class={check}
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>

    <button class={option} data-theme-val="slate" role="menuitem">
      <span class="inline-flex items-center gap-[0.55rem]">
        <span class="inline-flex w-[18px] items-center justify-center text-[0.95rem] leading-none">
          ⚓
        </span>
        <span class="font-medium">Slate Navy</span>
      </span>
      <svg
        class={check}
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>

    <button class={option} data-theme-val="midnight" role="menuitem">
      <span class="inline-flex items-center gap-[0.55rem]">
        <span class="inline-flex w-[18px] items-center justify-center text-[0.95rem] leading-none">
          🌌
        </span>
        <span class="font-medium">Midnight OLED</span>
      </span>
      <svg
        class={check}
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>

    <div class="my-[0.3rem] h-px bg-line"></div>

    <button class={option} data-theme-val="auto" role="menuitem">
      <span class="inline-flex items-center gap-[0.55rem]">
        <span class="inline-flex w-[18px] items-center justify-center text-[0.95rem] leading-none">
          💻
        </span>
        <span class="font-medium">System Auto</span>
      </span>
      <svg
        class={check}
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>
  </div>
</div>

<style>
  /* keyframes have no utility form; referenced by the dropdown's arbitrary animate class */
  @keyframes themeDropdownFade {
    from {
      opacity: 0;
      margin-top: -4px;
    }
    to {
      opacity: 1;
      margin-top: 0;
    }
  }
</style>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle-btn");
    const dropdown = document.getElementById("theme-dropdown");
    const selector = document.getElementById("theme-selector");
    const activeIcon = document.getElementById("theme-active-icon");

    const themeIcons: Record<string, string> = {
      white: "☀️",
      cream: "📜",
      slate: "⚓",
      midnight: "🌌",
      auto: "💻",
    };

    function getEffectiveTheme(mode: string): string {
      if (mode === "auto") {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "slate"
          : "cream";
      }
      return mode;
    }

    function updateThemeUI(storedTheme: string) {
      const effectiveTheme = getEffectiveTheme(storedTheme);

      // Update icon on the button
      if (activeIcon) {
        activeIcon.textContent =
          storedTheme === "auto" ? "💻" : themeIcons[effectiveTheme] || "📜";
      }

      // Update active checks in dropdown
      document
        .querySelectorAll<HTMLButtonElement>(".theme-option")
        .forEach((opt) => {
          const val = opt.getAttribute("data-theme-val");
          if (val === storedTheme) {
            opt.classList.add("active");
            opt.setAttribute("aria-selected", "true");
          } else {
            opt.classList.remove("active");
            opt.removeAttribute("aria-selected");
          }
        });
    }

    function applyTheme(mode: string) {
      localStorage.setItem("minrock_theme", mode);
      const effective = getEffectiveTheme(mode);
      document.documentElement.setAttribute("data-theme", effective);

      updateThemeUI(mode);

      // Dispatch event for reactive components (e.g. embedded comment themes)
      window.dispatchEvent(
        new CustomEvent("minrock-theme-change", {
          detail: { theme: effective, mode },
        }),
      );
    }

    function positionDropdown() {
      if (!dropdown) return;
      if (window.innerWidth <= 768) {
        dropdown.style.left = "50%";
        dropdown.style.right = "auto";
        dropdown.style.transform = "translateX(-50%)";

        const rect = dropdown.getBoundingClientRect();
        const pad = 12;
        if (rect.left < pad) {
          const offset = pad - rect.left;
          dropdown.style.transform = `translateX(calc(-50% + ${offset}px))`;
        } else if (rect.right > window.innerWidth - pad) {
          const offset = rect.right - (window.innerWidth - pad);
          dropdown.style.transform = `translateX(calc(-50% - ${offset}px))`;
        }
      } else {
        dropdown.style.left = "";
        dropdown.style.right = "";
        dropdown.style.transform = "";
      }
    }

    // Initialize UI on mount
    const saved = localStorage.getItem("minrock_theme") || "cream";
    updateThemeUI(saved);

    // Toggle dropdown
    btn?.addEventListener("click", (e) => {
      e.stopPropagation();
      // Close other dropdowns if open
      document
        .querySelectorAll(".lang-dropdown.open, .social-dropdown-menu.open")
        .forEach((d) => d.classList.remove("open"));
      document
        .querySelectorAll("#lang-btn, #social-menu-btn")
        .forEach((b) => b.setAttribute("aria-expanded", "false"));

      const open = dropdown?.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(!!open));

      if (open) {
        positionDropdown();
      }
    });

    window.addEventListener("resize", () => {
      if (dropdown?.classList.contains("open")) {
        positionDropdown();
      }
    });

    // Option clicks
    document
      .querySelectorAll<HTMLButtonElement>(".theme-option")
      .forEach((opt) => {
        opt.addEventListener("click", () => {
          const val = opt.getAttribute("data-theme-val");
          if (!val) return;
          dropdown?.classList.remove("open");
          btn?.setAttribute("aria-expanded", "false");
          applyTheme(val);
        });
      });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (!selector?.contains(e.target as Node)) {
        dropdown?.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
      }
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dropdown?.classList.contains("open")) {
        dropdown.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
        btn?.focus();
      }
    });

    // Listen to OS theme changes if on auto
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        const current = localStorage.getItem("minrock_theme") || "cream";
        if (current === "auto") {
          applyTheme("auto");
        }
      });
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
