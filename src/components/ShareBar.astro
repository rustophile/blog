---
import { siteConfig } from "../config/site";

interface Props {
  title?: string;
  url?: string;
  description?: string;
}

const { title = "Article", url = "", description = "" } = Astro.props;

const linkedinUrl = siteConfig.socialLinks.linkedin;
const githubUrl = siteConfig.socialLinks.github;

const shareTitle = encodeURIComponent(title);
const shareUrl = encodeURIComponent(url);

const socialLinks = [
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
    title: "Share on LinkedIn",
    icon: "linkedin",
  },
  {
    name: "X (Twitter)",
    href: `https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`,
    title: "Share on X",
    icon: "x",
  },
  {
    name: "WhatsApp",
    href: `https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`,
    title: "Share on WhatsApp",
    icon: "whatsapp",
  },
  {
    name: "Telegram",
    href: `https://t.me/share/url?url=${shareUrl}&text=${shareTitle}`,
    title: "Share on Telegram",
    icon: "telegram",
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
    title: "Share on Facebook",
    icon: "facebook",
  },
  {
    name: "Email",
    href: `mailto:?subject=${shareTitle}&body=${shareTitle}%0A%0A${shareUrl}`,
    title: "Share via Email",
    icon: "email",
  },
];

// Shared by the LinkedIn, GitHub and Share buttons in the bar
const shareBtn =
  "inline-flex items-center gap-[0.35rem] py-[0.4rem] px-[0.65rem] border border-line rounded-[6px] bg-surface text-fg text-[0.82rem] cursor-pointer no-underline [transition:background-color_0.15s_ease,border-color_0.15s_ease,color_0.15s_ease,transform_0.1s_ease] hover:bg-subtle hover:border-accent hover:text-accent";
---

<div
  class="flex items-center gap-3 py-4 mt-8 border-t border-line"
  aria-label="Share and connect"
>
  <span class="text-[0.88rem] font-semibold text-muted">Share:</span>
  <div class="flex items-center gap-2">
    <!-- LinkedIn -->
    {linkedinUrl && (
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={shareBtn}
        title="LinkedIn"
        aria-label="LinkedIn"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z" />
        </svg>
      </a>
    )}

    <!-- GitHub -->
    {githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={shareBtn}
        title="GitHub"
        aria-label="GitHub"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    )}

    <!-- Interactive Share Button (Replaces static Copy link) -->
    <button
      type="button"
      class:list={[shareBtn, "font-medium hover:[transform:translateY(-1px)]"]}
      id="open-share-modal"
      title="Share article"
      aria-label="Share article"
      aria-haspopup="dialog"
      data-url={url}
      data-title={title}
      data-desc={description}
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
        <polyline points="16 6 12 2 8 6"></polyline>
        <line x1="12" y1="2" x2="12" y2="15"></line>
      </svg>
      <span>Share</span>
    </button>
  </div>
</div>

<!-- Notion-Style Share Modal Overlay -->
<div
  id="share-modal-backdrop"
  class="group hidden [&.open]:flex fixed inset-0 z-[1000] bg-[rgba(15,23,42,0.65)] [-webkit-backdrop-filter:blur(8px)] py-6 px-4 items-center justify-center opacity-0 [&.open]:opacity-100 transition-opacity duration-[180ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="share-modal-title"
>
  <div
    class="w-full max-w-[480px] bg-page border border-line rounded-[12px] shadow-[0_24px_48px_-12px_rgba(0,0,0,0.45),0_0_0_1px_rgba(255,255,255,0.05)] flex flex-col overflow-hidden [transform:scale(0.96)_translateY(-8px)] group-[.open]:[transform:scale(1)_translateY(0)] transition-[transform] duration-[180ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
    id="share-modal-dialog"
  >
    <!-- Header -->
    <div class="flex items-center justify-between py-[0.85rem] px-[1.15rem] border-b border-line bg-surface">
      <div class="flex items-center gap-2">
        <svg
          class="text-accent"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <h3
          id="share-modal-title"
          class="m-0 text-[0.95rem] font-semibold text-fg"
        >
          Share article
        </h3>
      </div>
      <button
        id="share-modal-close"
        class="group/close bg-transparent border-none cursor-pointer p-0 flex items-center"
        type="button"
        aria-label="Close share dialog (Esc)"
        title="Close (Esc)"
      >
        <kbd class="inline-flex items-center justify-center font-mono text-[0.6875rem] font-semibold text-muted bg-page border border-line rounded-[4px] py-[0.15rem] px-[0.4rem] shadow-[0_1px_2px_rgba(0,0,0,0.05)] transition-[color,border-color] duration-150 ease-[ease] group-hover/close:text-fg group-hover/close:border-accent">
          ESC
        </kbd>
      </button>
    </div>

    <!-- Body -->
    <div class="p-[1.15rem] flex flex-col gap-[1.15rem]">
      <!-- Mini Preview Card (Notion-style) -->
      <div class="bg-surface border border-line rounded-[8px] py-[0.9rem] px-4 flex flex-col gap-[0.6rem] shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
        <div class="flex items-center justify-between pb-[0.45rem] border-b border-line">
          <div class="flex items-center gap-[0.35rem]">
            <span class="text-[0.9rem]">🦀</span>
            <span class="text-[0.8rem] font-semibold text-fg tracking-[-0.01em]">
              {siteConfig.title}
            </span>
          </div>
          <span class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.05em] text-muted bg-subtle py-[0.1rem] px-[0.4rem] rounded-[4px] border border-line">
            Preview
          </span>
        </div>
        <div class="flex flex-col gap-[0.3rem]">
          <div class="flex items-start gap-[0.45rem]">
            <span class="text-[1rem] leading-[1.35] shrink-0">📄</span>
            <span class="text-[0.98rem] font-semibold text-fg leading-[1.35]">
              {title}
            </span>
          </div>
          {description && (
            <p class="m-0 text-[0.8rem] text-muted leading-[1.5] line-clamp-2">
              {description}
            </p>
          )}
        </div>
      </div>

      <!-- Canonical URL Field with Copy Button -->
      <div class="flex items-stretch gap-2">
        <div class="flex-[1] relative flex items-center min-w-0">
          <svg
            class="absolute left-3 text-muted pointer-events-none"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <input
            type="text"
            id="share-url-input"
            class="w-full bg-subtle border border-line rounded-[6px] py-2 pr-3 pl-[2.15rem] font-mono text-[0.78rem] text-muted outline-none text-ellipsis whitespace-nowrap overflow-hidden transition-[border-color,color] duration-150 ease-[ease] focus:border-accent focus:text-fg"
            value={url}
            readonly
            aria-label="Article canonical link"
            spellcheck="false"
          />
        </div>
        <button
          type="button"
          id="share-copy-btn"
          class="inline-flex items-center gap-[0.4rem] py-2 px-[0.85rem] border border-accent rounded-[6px] bg-accent text-on-accent text-[0.82rem] font-semibold cursor-pointer whitespace-nowrap shrink-0 [transition:background-color_0.15s_ease,border-color_0.15s_ease,transform_0.1s_ease] hover:bg-accent-hover hover:border-accent-hover active:[transform:scale(0.98)] [&.copied]:bg-success [&.copied]:border-success [&.copied]:text-on-accent"
          aria-label="Copy canonical link to clipboard"
        >
          <svg
            class="link-icon"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <svg
            class="check-icon"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="display: none;"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span class="share-copy-text">Copy URL</span>
        </button>
      </div>

      <!-- Social Share Grid (Calibrated Minrock-style buttons: square, 6px border-radius) -->
      <div class="flex flex-col gap-[0.65rem]">
        <div class="text-[0.72rem] font-semibold font-mono uppercase tracking-[0.05em] text-muted">
          Share directly to:
        </div>
        <div class="grid grid-cols-[repeat(6,1fr)] gap-2 max-[480px]:grid-cols-[repeat(3,1fr)]">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-share-btn flex items-center justify-center h-[42px] border border-line rounded-[6px] bg-surface text-fg no-underline transition-all duration-[180ms] ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-subtle hover:border-accent hover:text-accent hover:[transform:translateY(-2px)] hover:shadow-[0_4px_12px_rgba(0,0,0,0.12)] active:[transform:translateY(0)]"
              title={item.title}
              aria-label={item.title}
              data-social={item.icon}
            >
              {item.icon === "linkedin" && (
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z" />
                </svg>
              )}
              {item.icon === "x" && (
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {item.icon === "whatsapp" && (
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.24-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.45 1.03 2.62.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31" />
                </svg>
              )}
              {item.icon === "telegram" && (
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="m20.665 3.717-17.73 6.837c-1.21.486-1.2 1.166-.222 1.467l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.313 4.693c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.44z" />
                </svg>
              )}
              {item.icon === "facebook" && (
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
                </svg>
              )}
              {item.icon === "email" && (
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let activeKeydownHandler: ((e: KeyboardEvent) => void) | null = null;

  function setupShareModal() {
    const triggerBtn = document.getElementById("open-share-modal");
    const backdrop = document.getElementById("share-modal-backdrop");
    const closeBtn = document.getElementById("share-modal-close");
    const copyBtn = document.getElementById("share-copy-btn");
    const urlInput = document.getElementById(
      "share-url-input",
    ) as HTMLInputElement | null;

    if (!triggerBtn || !backdrop) return;

    // Ensure URL is current if window.location is active
    if (urlInput && (!urlInput.value || urlInput.value.startsWith("/"))) {
      urlInput.value = window.location.href;
    }

    // Dynamic social URLs update if window.location differs
    const activeUrl = (urlInput && urlInput.value) || window.location.href;
    const activeTitle = triggerBtn.getAttribute("data-title") || document.title;
    const socialLinks =
      backdrop.querySelectorAll<HTMLAnchorElement>(".social-share-btn");

    socialLinks.forEach((link) => {
      const type = link.getAttribute("data-social");
      const u = encodeURIComponent(activeUrl);
      const t = encodeURIComponent(activeTitle);
      if (type === "linkedin")
        link.href = `https://www.linkedin.com/sharing/share-offsite/?url=${u}`;
      if (type === "x")
        link.href = `https://twitter.com/intent/tweet?url=${u}&text=${t}`;
      if (type === "whatsapp")
        link.href = `https://api.whatsapp.com/send?text=${t}%20${u}`;
      if (type === "telegram")
        link.href = `https://t.me/share/url?url=${u}&text=${t}`;
      if (type === "facebook")
        link.href = `https://www.facebook.com/sharer/sharer.php?u=${u}`;
      if (type === "email")
        link.href = `mailto:?subject=${t}&body=${t}%0A%0A${u}`;
    });

    const openModal = () => {
      backdrop.classList.add("open");
      backdrop.setAttribute("aria-hidden", "false");
      triggerBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      if (urlInput) {
        setTimeout(() => {
          urlInput.focus();
          urlInput.select();
        }, 50);
      }
    };

    const closeModal = () => {
      backdrop.classList.remove("open");
      backdrop.setAttribute("aria-hidden", "true");
      triggerBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      triggerBtn.focus();
    };

    triggerBtn.onclick = openModal;
    if (closeBtn) closeBtn.onclick = closeModal;

    backdrop.onclick = (e) => {
      if (e.target === backdrop) closeModal();
    };

    // Remove previous keydown handler if it exists
    if (activeKeydownHandler) {
      document.removeEventListener("keydown", activeKeydownHandler);
      activeKeydownHandler = null;
    }

    activeKeydownHandler = (e: KeyboardEvent) => {
      if (e.key === "Escape" && backdrop.classList.contains("open")) {
        closeModal();
      }
    };
    document.addEventListener("keydown", activeKeydownHandler);

    // Copy action with instant feedback
    if (copyBtn && urlInput) {
      copyBtn.onclick = async () => {
        const textToCopy = urlInput.value || window.location.href;
        const textSpan = copyBtn.querySelector(".share-copy-text");
        const linkIcon = copyBtn.querySelector<HTMLElement>(".link-icon");
        const checkIcon = copyBtn.querySelector<HTMLElement>(".check-icon");

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add("copied");
          if (textSpan) textSpan.textContent = "Copied!";
          if (linkIcon) linkIcon.style.display = "none";
          if (checkIcon) checkIcon.style.display = "inline-block";

          setTimeout(() => {
            copyBtn.classList.remove("copied");
            if (textSpan) textSpan.textContent = "Copy URL";
            if (linkIcon) linkIcon.style.display = "inline-block";
            if (checkIcon) checkIcon.style.display = "none";
          }, 2000);
        } catch {
          urlInput.select();
          try {
            navigator.clipboard?.writeText(textToCopy);
          } catch {
            // fallback
          }
          copyBtn.classList.add("copied");
          if (textSpan) textSpan.textContent = "Copied!";
          setTimeout(() => {
            copyBtn.classList.remove("copied");
            if (textSpan) textSpan.textContent = "Copy URL";
          }, 2000);
        }
      };
    }
  }

  // Initial run and page navigation hooks
  setupShareModal();
  document.addEventListener("astro:page-load", setupShareModal);
  document.addEventListener("astro:after-swap", setupShareModal);

  // Immediate cleanup before DOM replacement
  document.addEventListener("astro:before-swap", () => {
    if (activeKeydownHandler) {
      document.removeEventListener("keydown", activeKeydownHandler);
      activeKeydownHandler = null;
    }
    document.body.style.overflow = "";
  });
</script>
