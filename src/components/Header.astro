---
import { siteConfig } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";
import RustR from "./RustR.astro";
import SocialDropdown from "./SocialDropdown.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const features = siteConfig.features ?? {};
const showSearch = features.search !== false;
const showThemeSwitcher = features.themeSwitcher !== false;
---

<header class="sticky top-0 z-50 mb-8 border-b border-border bg-background py-[0.85rem] backdrop-blur-[12px] transition-[background-color,border-color] duration-200 ease-[ease]">
  <div class="mx-auto w-full max-w-[1080px] px-6 flex items-center justify-between gap-6 max-md:flex-wrap max-md:gap-y-[0.85rem]">
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2 text-[1.25rem] font-bold tracking-[-0.02em] text-foreground no-underline"
      aria-label={`${siteConfig.title} Home`}
    >
      <span class="inline-flex items-baseline" aria-hidden="true">
        <RustR class="mr-[0.04em]" />
        {siteConfig.title.slice(1)}
      </span>
    </a>

    <!-- Main Nav -->
    <nav class="flex items-center gap-6" aria-label="Main Navigation">
      {siteConfig.navLinks.map((link) => {
        const isActive =
          currentPath === link.href ||
          (link.href !== "/" && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={[
              "rounded-[4px] px-[0.35rem] py-[0.2rem] text-[0.95rem] font-medium text-muted-foreground no-underline transition-[color,background-color] duration-150 ease-[ease] hover:text-foreground [&.active]:font-semibold [&.active]:text-foreground",
              { active: isActive },
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.title}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-[0.85rem] max-md:mt-[0.2rem] max-md:w-full max-md:justify-center">
      <!-- Search Trigger (Desktop) -->
      {showSearch && (
        <button
          id="header-search-btn"
          class="inline-flex min-w-[145px] cursor-pointer items-center justify-between gap-3 rounded-[6px] border border-border bg-card px-[0.65rem] py-[0.35rem] text-[0.85rem] text-muted-foreground transition-[border-color,background-color,color] duration-150 ease-[ease] hover:border-link hover:bg-muted hover:text-foreground max-[900px]:hidden"
          type="button"
          aria-label="Search (Ctrl + K)"
          title="Search (Ctrl + K)"
        >
          <div class="inline-flex items-center gap-[0.45rem]">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <span>Search...</span>
          </div>
          <kbd class="rounded-[4px] border border-border bg-background px-[0.35rem] py-[0.1rem] font-mono text-[0.72rem]">
            Ctrl K
          </kbd>
        </button>
      )}

      <!-- Mobile Search Button -->
      {showSearch && (
        <button
          id="mobile-search-btn"
          class="hidden size-[34px] cursor-pointer items-center justify-center rounded-[6px] border border-border bg-card p-0 text-muted-foreground hover:border-link hover:bg-muted hover:text-foreground max-[900px]:inline-flex"
          type="button"
          aria-label="Search"
          title="Search"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
      )}

      <!-- Clustered Controls: Social + Theme Dropdowns -->
      <div class="flex items-center gap-[0.4rem]">
        <SocialDropdown />
        {showThemeSwitcher && <ThemeToggle />}
      </div>
    </div>
  </div>
</header>
