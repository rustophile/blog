---
// Client-side script to inject copy buttons into all <pre> code blocks
---

<script>
  function setupCodeCopyButtons() {
    const preBlocks = document.querySelectorAll("pre");

    preBlocks.forEach((pre) => {
      // Avoid duplicate buttons
      if (pre.querySelector(".code-copy-btn")) return;

      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "code-copy-btn absolute top-[0.65rem] right-[0.65rem] z-10 inline-flex cursor-pointer items-center gap-[0.35rem] rounded-[4px] border border-[rgba(255,255,255,0.15)] bg-[rgba(255,255,255,0.1)] px-[0.6rem] py-[0.3rem] font-sans text-[0.75rem] text-[color:var(--code-text,#e2e8f0)] opacity-0 select-none transition-[opacity,background-color,color] duration-200 ease-[ease] hover:bg-[rgba(255,255,255,0.2)] focus-visible:opacity-100 [pre:hover_&]:opacity-100 [&.copied]:border-[#34d399] [&.copied]:text-[#34d399] [&.copied]:opacity-100";
      button.setAttribute("aria-label", "Copy code to clipboard");
      button.innerHTML = `
        <svg class="copy-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
        <span class="copy-label">Copy</span>
      `;

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code");
        const textToCopy = code ? code.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(textToCopy);
          button.classList.add("copied");
          const label = button.querySelector(".copy-label");
          if (label) label.textContent = "Copied!";

          setTimeout(() => {
            button.classList.remove("copied");
            if (label) label.textContent = "Copy";
          }, 2000);
        } catch {
          // Fallback
        }
      });

      pre.style.position = "relative";
      pre.appendChild(button);
    });
  }

  setupCodeCopyButtons();
  document.addEventListener("astro:after-swap", setupCodeCopyButtons);
</script>

<style is:global>
  /* Shiki/Markdown <pre> blocks aren't our markup; anchor for the absolutely positioned button */
  pre {
    position: relative;
  }
</style>
