---
// src/components/AudioPlayer.astro
// Accessible client-side Text-to-Speech audio reader using browser Web Speech API
export interface Props {
  selector?: string;
  title?: string;
  label?: string;
}

const {
  selector = ".post-content",
  title = "",
  label = "Listen to Article",
} = Astro.props;

// Shared by the four drawer buttons; colours/padding are set per button
const audioBtn =
  "inline-flex cursor-pointer items-center gap-[0.4rem] rounded-[6px] border font-sans text-[0.85rem] transition-[background-color,border-color] duration-150 ease-[ease] disabled:cursor-not-allowed disabled:opacity-50";
const audioBtnDefault =
  "border-border bg-background py-[0.38rem] text-foreground enabled:hover:border-link enabled:hover:bg-muted enabled:hover:text-link";
---

<div
  id="audio-player-root"
  class="group relative mx-0 mt-6 mb-8 overflow-hidden rounded-lg border border-border bg-card transition-[border-color,box-shadow,background-color] duration-200 ease-[ease] hover:border-link [&.is-active-player]:sticky [&.is-active-player]:top-18 [&.is-active-player]:z-35 [&.is-active-player.is-sticky]:border-link [&.is-active-player.is-sticky]:shadow-[0_10px_28px_-6px_rgba(0,0,0,0.25),0_2px_8px_-2px_color-mix(in_oklab,var(--link-bright)_25%,transparent)] [&.is-active-player.is-sticky]:backdrop-blur-[12px] [&.is-playing]:border-link is-collapsed"
  data-selector={selector}
  data-title={title}
  aria-label="Accessible audio reader"
>
  <!-- Trigger Bar -->
  <button
    id="audio-toggle-btn"
    type="button"
    class="flex w-full cursor-pointer items-center justify-between border-none bg-transparent px-5 py-3 text-left text-foreground transition-[background-color] duration-150 ease-[ease] hover:bg-muted"
    aria-expanded="false"
    aria-controls="audio-player-drawer"
    title="Expand audio player"
  >
    <div class="flex items-center gap-[0.65rem]">
      <div class="flex items-center text-link" aria-hidden="true">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path
            class="group-[.is-playing]:animate-[pulse-wave_1.2s_infinite_ease-in-out]"
            d="M15.54 8.46a5 5 0 0 1 0 7.07"
          ></path>
          <path
            class="group-[.is-playing]:animate-[pulse-wave_1.2s_infinite_ease-in-out_0.2s]"
            d="M19.07 4.93a10 10 0 0 1 0 14.14"
          ></path>
        </svg>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-[0.92rem]">
        <span class="font-semibold">{label}</span>
        <span class="text-muted-foreground opacity-50" aria-hidden="true">
          •
        </span>
        <span id="audio-estimate" class="text-[0.85rem] text-muted-foreground">
          Calculating...
        </span>
      </div>
    </div>

    <div class="flex items-center gap-[0.65rem]">
      <span
        id="audio-status-badge"
        class="rounded-sm border border-border bg-background px-2 py-[0.15rem] font-mono text-[0.75rem] text-muted-foreground transition-[border-color,color] duration-200 ease-[ease] group-[.is-playing]:border-link group-[.is-playing]:font-semibold group-[.is-playing]:text-link"
      >
        Ready to play
      </span>
      <span
        class="flex items-center text-muted-foreground transition-[transform,color] duration-[0.25s,0.2s] ease-[cubic-bezier(0.16,1,0.3,1),ease] group-[.is-expanded]:[transform:rotate(180deg)]"
        aria-hidden="true"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </div>
  </button>

  <!-- Drawer Container -->
  <div
    id="audio-player-drawer"
    class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-[0.28s,0.2s] ease-[cubic-bezier(0.16,1,0.3,1),ease] group-[.is-expanded]:grid-rows-[1fr] group-[.is-expanded]:opacity-100"
    role="region"
    aria-label="Audio player controls"
  >
    <div class="overflow-hidden px-5 pt-0 pb-4">
      <div class="mb-[0.85rem] h-px bg-border" aria-hidden="true"></div>

      <!-- Controls Row -->
      <div class="flex flex-wrap items-center gap-[0.65rem]">
        <!-- Play / Pause -->
        <button
          id="audio-play-btn"
          type="button"
          class:list={[
            audioBtn,
            "border-link bg-primary px-3 py-[0.38rem] font-semibold text-primary-foreground enabled:hover:border-link-hover enabled:hover:bg-link-hover enabled:hover:text-primary-foreground",
          ]}
          aria-label="Play audio"
        >
          <svg
            class="icon-play [&.hidden]:hidden!"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <svg
            class="icon-pause hidden [&.hidden]:hidden!"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <span id="audio-play-text">Play</span>
        </button>

        <!-- Stop -->
        <button
          id="audio-stop-btn"
          type="button"
          class:list={[audioBtn, audioBtnDefault, "px-3"]}
          aria-label="Stop playback"
          disabled
        >
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <rect x="5" y="5" width="14" height="14" rx="2"></rect>
          </svg>
          <span>Stop</span>
        </button>

        <!-- Prev / Next Paragraph -->
        <div class="flex gap-1">
          <button
            id="audio-prev-btn"
            type="button"
            class:list={[audioBtn, audioBtnDefault, "px-2"]}
            aria-label="Previous paragraph"
            disabled
            title="Previous paragraph"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="19 20 9 12 19 4 19 20"></polygon>
              <line x1="5" y1="19" x2="5" y2="5"></line>
            </svg>
          </button>
          <button
            id="audio-next-btn"
            type="button"
            class:list={[audioBtn, audioBtnDefault, "px-2"]}
            aria-label="Next paragraph"
            disabled
            title="Next paragraph"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="5 4 15 12 5 20 5 4"></polygon>
              <line x1="19" y1="5" x2="19" y2="19"></line>
            </svg>
          </button>
        </div>

        <!-- Speed Rate Selector -->
        <div>
          <button
            type="button"
            id="audio-rate-btn"
            class="cursor-pointer rounded-sm border border-border bg-background px-[0.6rem] py-[0.35rem] font-mono text-[0.8rem] text-muted-foreground hover:border-link hover:text-foreground"
            aria-label="Playback speed"
            title="Adjust playback speed"
          >
            <span id="audio-rate-val">1.0x</span>
          </button>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="mt-[0.85rem]">
        <div
          class="h-1 w-full overflow-hidden rounded-xs bg-border"
          role="progressbar"
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax="100"
        >
          <div
            id="audio-progress-fill"
            class="h-full bg-primary transition-[width] duration-200 ease-[ease]"
            style="width: 0%;"
          ></div>
        </div>
        <div class="mt-[0.35rem] flex justify-between font-mono text-[0.75rem] text-muted-foreground">
          <span id="audio-part-label">Paragraph 0 of 0</span>
          <span id="audio-pct-label">0%</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import "@/lib/audio-player/controller";
</script>

<style>
  /* Keyframes can't be expressed as utilities; used by the speaker wave paths */
  @keyframes pulse-wave {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* Added by JS to rendered Markdown elements outside this component */
  :global(.audio-speaking-active) {
    background-color: color-mix(in oklab, var(--link-bright) 12%, transparent);
    border-radius: 4px;
    outline: 2px dashed var(--link-bright);
    outline-offset: 4px;
    transition: background-color 0.2s ease;
  }
</style>
