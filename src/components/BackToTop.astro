---
// Floating Back to Top button
---

<button
  id="back-to-top"
  class="fixed right-8 bottom-10 z-[99] flex h-[40px] w-[40px] cursor-pointer items-center justify-center rounded-[8px] border border-line bg-surface text-muted opacity-0 shadow-[0_4px_12px_rgba(0,0,0,0.1)] pointer-events-none [transition:opacity_0.25s_ease,color_0.15s_ease,background-color_0.15s_ease,border-color_0.15s_ease,transform_0.15s_ease,box-shadow_0.15s_ease] [&.visible]:pointer-events-auto [&.visible]:opacity-85 [&.visible]:hover:border-accent [&.visible]:hover:bg-subtle [&.visible]:hover:text-accent [&.visible]:hover:opacity-100 [&.visible]:hover:shadow-[0_6px_16px_rgba(0,0,0,0.15)] [&.visible]:hover:[transform:translateY(-3px)]"
  aria-label="Back to top"
  title="Back to top"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  let backToTopController: AbortController | null = null;

  function setupBackToTop() {
    // Teardown any previous listeners from prior page navigation
    if (backToTopController) {
      backToTopController.abort();
      backToTopController = null;
    }

    const btn = document.getElementById("back-to-top");
    if (!btn) return;

    backToTopController = new AbortController();
    const { signal } = backToTopController;

    let ticking = false;

    function handleScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > 300) {
            btn?.classList.add("visible");
          } else {
            btn?.classList.remove("visible");
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", handleScroll, { passive: true, signal });
    handleScroll();

    btn.addEventListener(
      "click",
      () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      },
      { signal },
    );
  }

  // Initial run and page navigation hooks
  setupBackToTop();
  document.addEventListener("astro:page-load", setupBackToTop);
  document.addEventListener("astro:after-swap", setupBackToTop);

  // Immediate cleanup before DOM replacement
  document.addEventListener("astro:before-swap", () => {
    if (backToTopController) {
      backToTopController.abort();
      backToTopController = null;
    }
  });
</script>
