---
// The R from the Rust logo, without its gear, as the first letter of "Rustophile".
// Rust logo © the Rust Project, CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/),
// from github.com/rust-lang/rust-artwork; changed: the R alone, recolored to currentColor.
// It's drawn as the logo draws it (fill plus a 1-unit round-joined stroke) and sized to Fira
// Sans's cap height (0.689em), sitting on the baseline.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={[
    "inline-block h-[0.689em] w-auto shrink-0 overflow-visible",
    className,
  ]}
  viewBox="-40 -26 81 49"
  aria-hidden="true"
>
  <path
    transform="translate(0.5 0.5)"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1"
    stroke-linejoin="round"
    d="M -9,-15 H 4 C 12,-15 12,-7 4,-7 H -9 Z M -40,22 H 0 V 11 H -9 V 3 H 1 C 12,3 6,22 15,22 H 40 V 3 H 34 V 5 C 34,13 25,12 24,7 C 23,2 19,-2 18,-2 C 33,-10 24,-26 12,-26 H -35 V -15 H -25 V 11 H -40 Z"
  ></path>
</svg>
