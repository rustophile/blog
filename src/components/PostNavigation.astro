---
import type { CollectionEntry } from "astro:content";

interface Props {
  older: CollectionEntry<"blog"> | null;
  newer: CollectionEntry<"blog"> | null;
}

const { older, newer } = Astro.props;
const linkClass =
  "group flex flex-col gap-[0.35rem] rounded-lg border border-border bg-card p-4 no-underline transition-[border-color,background-color,transform] duration-[0.2s,0.2s,0.15s] ease-[ease] hover:border-link hover:bg-muted hover:[transform:translateY(-2px)]";
---

<nav
  class="mt-10 grid grid-cols-[1fr_1fr] gap-4 border-t border-border pt-6 max-[600px]:grid-cols-[1fr]"
  aria-label="Post navigation"
>
  {older ? (
    <a href={`/blog/${older.id}`} class={linkClass}>
      <span class="font-mono text-[0.75rem] tracking-[0.05em] text-muted-foreground uppercase">
        ← Older
      </span>
      <span class="text-[0.95rem] leading-[1.4] font-medium text-foreground group-hover:text-link">
        {older.data.title}
      </span>
    </a>
  ) : (
    <div class="block"></div>
  )}
  {newer ? (
    <a
      href={`/blog/${newer.id}`}
      class:list={[linkClass, "items-end text-right"]}
    >
      <span class="font-mono text-[0.75rem] tracking-[0.05em] text-muted-foreground uppercase">
        Newer →
      </span>
      <span class="text-[0.95rem] leading-[1.4] font-medium text-foreground group-hover:text-link">
        {newer.data.title}
      </span>
    </a>
  ) : (
    <div class="block"></div>
  )}
</nav>
