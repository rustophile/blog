---
// src/components/SocialDropdown.astro
// Compact dropdown menu grouping social media and contact links
import { siteConfig } from "../config/site";

// shared by the three menu items and their icon badges (badge color is set per item)
const item =
  "group flex items-center gap-[0.65rem] rounded-[5px] px-[0.65rem] py-[0.45rem] text-fg no-underline transition-[background-color,color] duration-[120ms] ease-[ease] hover:bg-subtle hover:text-accent";
const icon =
  "inline-flex size-6 shrink-0 items-center justify-center rounded-[4px] border border-line bg-surface transition-[color,border-color] duration-[120ms] ease-[ease] group-hover:border-accent group-hover:text-accent";
---

<div class="relative inline-flex items-center" id="social-dropdown-container">
  <button
    id="social-menu-btn"
    class="group inline-flex size-[34px] cursor-pointer items-center justify-center gap-[3px] rounded-[6px] border border-line bg-surface p-0 text-muted transition-[color,background-color,border-color,transform] duration-150 ease-[ease] hover:border-accent hover:bg-subtle hover:text-fg"
    aria-label="Connect and social links"
    aria-haspopup="true"
    aria-expanded="false"
    title="Connect / Redes e Contato"
  >
    <!-- Social / At icon -->
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path>
    </svg>
    <svg
      class="-ml-px opacity-60 transition-transform duration-150 ease-[ease] group-aria-expanded:rotate-180"
      width="9"
      height="9"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Floating Social Dropdown -->
  <div
    id="social-dropdown-menu"
    class="social-dropdown-menu absolute top-[calc(100%+6px)] right-0 z-[1000] hidden min-w-[175px] animate-[socialDropdownFade_0.15s_ease] rounded-[8px] border border-line bg-page p-[0.35rem] shadow-[0_10px_25px_-5px_rgba(0,0,0,0.2)] backdrop-blur-[12px] max-md:right-auto max-md:left-1/2 max-md:max-w-[calc(100vw-24px)] max-md:[transform:translateX(-50%)] [&.open]:block"
    role="menu"
    aria-label="Social and contact options"
  >
    <div class="px-[0.65rem] pt-[0.25rem] pb-[0.35rem] font-mono text-[0.68rem] font-bold tracking-[0.06em] text-muted opacity-80">
      CONNECT
    </div>

    {siteConfig.socialLinks.linkedin && (
      <a
        href={siteConfig.socialLinks.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class={item}
        role="menuitem"
      >
        <span class={`${icon} text-[#0a66c2]`}>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z" />
          </svg>
        </span>
        <div class="flex min-w-0 flex-1 flex-col gap-px">
          <span class="text-[0.84rem] leading-[1.2] font-semibold text-fg group-hover:text-accent">
            LinkedIn
          </span>
          <span class="font-mono text-[0.72rem] leading-[1.1] text-muted">
            ↗ Profile
          </span>
        </div>
      </a>
    )}

    {siteConfig.socialLinks.github && (
      <a
        href={siteConfig.socialLinks.github}
        target="_blank"
        rel="noopener noreferrer"
        class={item}
        role="menuitem"
      >
        <span class={`${icon} text-muted`}>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </span>
        <div class="flex min-w-0 flex-1 flex-col gap-px">
          <span class="text-[0.84rem] leading-[1.2] font-semibold text-fg group-hover:text-accent">
            GitHub
          </span>
          <span class="font-mono text-[0.72rem] leading-[1.1] text-muted">
            ↗ Repository
          </span>
        </div>
      </a>
    )}

    {siteConfig.socialLinks.email && (
      <a
        href={
          siteConfig.socialLinks.email.startsWith("http")
            ? siteConfig.socialLinks.email
            : `mailto:${siteConfig.socialLinks.email}`
        }
        target={
          siteConfig.socialLinks.email.startsWith("http") ? "_blank" : undefined
        }
        rel={
          siteConfig.socialLinks.email.startsWith("http")
            ? "noopener noreferrer"
            : undefined
        }
        class={item}
        role="menuitem"
      >
        <span class={`${icon} text-muted`}>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <div class="flex min-w-0 flex-1 flex-col gap-px">
          <span class="text-[0.84rem] leading-[1.2] font-semibold text-fg group-hover:text-accent">
            Email
          </span>
          <span class="font-mono text-[0.72rem] leading-[1.1] text-muted">
            ↗ Send message
          </span>
        </div>
      </a>
    )}
  </div>
</div>

<style>
  /* keyframes have no utility form; referenced by the dropdown's arbitrary animate class */
  @keyframes socialDropdownFade {
    from {
      opacity: 0;
      margin-top: -4px;
    }
    to {
      opacity: 1;
      margin-top: 0;
    }
  }
</style>

<script>
  function setupSocialDropdown() {
    const btn = document.getElementById("social-menu-btn");
    const dropdown = document.getElementById("social-dropdown-menu");
    const container = document.getElementById("social-dropdown-container");

    function positionDropdown() {
      if (!dropdown) return;
      if (window.innerWidth <= 768) {
        dropdown.style.left = "50%";
        dropdown.style.right = "auto";
        dropdown.style.transform = "translateX(-50%)";

        const rect = dropdown.getBoundingClientRect();
        const pad = 12;
        if (rect.left < pad) {
          const offset = pad - rect.left;
          dropdown.style.transform = `translateX(calc(-50% + ${offset}px))`;
        } else if (rect.right > window.innerWidth - pad) {
          const offset = rect.right - (window.innerWidth - pad);
          dropdown.style.transform = `translateX(calc(-50% - ${offset}px))`;
        }
      } else {
        dropdown.style.left = "";
        dropdown.style.right = "";
        dropdown.style.transform = "";
      }
    }

    btn?.addEventListener("click", (e) => {
      e.stopPropagation();
      // Close other dropdowns if open
      document
        .querySelectorAll(".lang-dropdown.open, .theme-dropdown.open")
        .forEach((d) => d.classList.remove("open"));
      document
        .querySelectorAll("#lang-btn, #theme-toggle-btn")
        .forEach((b) => b.setAttribute("aria-expanded", "false"));

      const open = dropdown?.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(!!open));

      if (open) {
        positionDropdown();
      }
    });

    window.addEventListener("resize", () => {
      if (dropdown?.classList.contains("open")) {
        positionDropdown();
      }
    });

    document.addEventListener("click", (e) => {
      if (!container?.contains(e.target as Node)) {
        dropdown?.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dropdown?.classList.contains("open")) {
        dropdown.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
        btn?.focus();
      }
    });
  }

  setupSocialDropdown();
  document.addEventListener("astro:after-swap", setupSocialDropdown);
</script>
