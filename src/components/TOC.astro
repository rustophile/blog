---
// Sticky Table of Contents (TOC) with scrollspy
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
  title?: string;
}

const { headings, title = "On This Page" } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <nav
    class="toc sticky top-20 max-h-[calc(100vh-6.5rem)] overflow-y-auto px-0 pt-2 pb-4 [scrollbar-color:var(--border)_transparent] [scrollbar-width:thin]"
    aria-label="Table of contents"
  >
    <div class="mb-3 pl-3 font-mono text-[0.75rem] font-semibold tracking-[0.08em] text-muted-foreground uppercase">
      {title}
    </div>
    <ol class="m-0 list-none p-0">
      {filtered.map((h) => (
        <li class="m-0">
          <a
            href={`#${h.slug}`}
            class:list={[
              "toc-link block border-l-2 border-transparent py-[0.35rem] pr-0 leading-[1.45] text-muted-foreground no-underline transition-[color,border-color,transform] duration-150 ease-[ease] hover:text-foreground [&.active]:border-l-link [&.active]:font-semibold [&.active]:text-link",
              h.depth === 3 ? "pl-6 text-[0.76rem]" : "pl-3 text-[0.82rem]",
            ]}
          >
            <span>{h.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  let currentTOCController: AbortController | null = null;
  let clickTimeout: number | undefined;

  function initTOCScrollspy() {
    // Teardown any previous listeners from prior page navigation
    if (currentTOCController) {
      currentTOCController.abort();
      currentTOCController = null;
    }
    if (clickTimeout !== undefined) {
      window.clearTimeout(clickTimeout);
      clickTimeout = undefined;
    }

    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-link"),
    );
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>("article h2[id], article h3[id]"),
    );

    if (!tocLinks.length || !headings.length) return;

    currentTOCController = new AbortController();
    const { signal } = currentTOCController;

    let isClickScrolling = false;
    let ticking = false;

    function setActive(id: string) {
      if (!id) return;
      tocLinks.forEach((link) => {
        const href = link.getAttribute("href")?.replace(/^#/, "");
        if (href === id) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }
      });
    }

    function updateActiveHeading() {
      if (isClickScrolling) return;

      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;

      if (scrollY + windowHeight >= docHeight - 80) {
        setActive(headings[headings.length - 1].id);
        return;
      }

      const activationPoint = Math.max(150, windowHeight * 0.35);

      for (let i = headings.length - 1; i >= 0; i--) {
        const rect = headings[i].getBoundingClientRect();
        if (rect.top <= activationPoint) {
          setActive(headings[i].id);
          return;
        }
      }

      setActive(headings[0].id);
    }

    function requestScrollSpyUpdate() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    }

    tocLinks.forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          const targetId = link.getAttribute("href")?.replace(/^#/, "");
          if (targetId) {
            setActive(targetId);
            isClickScrolling = true;
            window.clearTimeout(clickTimeout);
            clickTimeout = window.setTimeout(() => {
              isClickScrolling = false;
              requestScrollSpyUpdate();
            }, 600);
          }
        },
        { signal },
      );
    });

    window.addEventListener("scroll", requestScrollSpyUpdate, {
      passive: true,
      signal,
    });
    window.addEventListener("resize", requestScrollSpyUpdate, {
      passive: true,
      signal,
    });
    requestScrollSpyUpdate();
  }

  // Initial run and page navigation hooks
  initTOCScrollspy();
  document.addEventListener("astro:page-load", initTOCScrollspy);
  document.addEventListener("astro:after-swap", initTOCScrollspy);

  // Immediate cleanup before DOM replacement
  document.addEventListener("astro:before-swap", () => {
    if (currentTOCController) {
      currentTOCController.abort();
      currentTOCController = null;
    }
    if (clickTimeout !== undefined) {
      window.clearTimeout(clickTimeout);
      clickTimeout = undefined;
    }
  });
</script>
