---
import TagBadge from "@/components/TagBadge.svelte";
export interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  stars?: number;
  repoUrl?: string;
  demoUrl?: string;
  category?: string;
  emoji?: string;
}

const {
  title,
  description,
  slug,
  tags = [],
  stars = 0,
  repoUrl,
  demoUrl,
  category,
  emoji = "📦",
} = Astro.props;
---

<article
  class="flex flex-col gap-3 p-5 border border-border rounded-lg bg-card [transition:border-color_0.2s_ease,background-color_0.2s_ease,transform_0.15s_ease] hover:border-link hover:bg-muted hover:[transform:translateY(-2px)]"
  data-card-link={`/projects/${slug}`}
>
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-2">
      <span class="text-[1.1rem]">{emoji}</span>
      <a
        href={`/projects/${slug}`}
        class="text-[1.05rem] font-semibold text-foreground no-underline transition-[color] duration-150 ease-[ease] hover:text-link"
      >
        {title}
      </a>
      {category && (
        <span class="text-[0.72rem] font-mono py-[0.15rem] px-[0.45rem] rounded-sm bg-background border border-border text-muted-foreground uppercase">
          {category}
        </span>
      )}
    </div>
    <div class="flex items-center gap-2">
      {stars > 0 && (
        <span
          class="text-[0.8rem] font-mono text-warning font-semibold"
          title={`${stars} stars`}
        >
          ★ {stars}
        </span>
      )}
      {repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.3rem] text-[0.8rem] font-mono text-muted-foreground no-underline py-[0.2rem] px-2 border border-border rounded-sm bg-background transition-[color,border-color] duration-150 ease-[ease] hover:text-link hover:border-link"
          title="Repository"
        >
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          Repo
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.3rem] text-[0.8rem] font-mono text-muted-foreground no-underline py-[0.2rem] px-2 border border-border rounded-sm bg-background transition-[color,border-color] duration-150 ease-[ease] hover:text-link hover:border-link"
          title="Live Demo"
        >
          Demo ↗
        </a>
      )}
    </div>
  </div>

  <p class="text-[0.95rem] text-muted-foreground m-0 leading-[1.6]">
    {description}
  </p>

  {tags.length > 0 && (
    <div class="flex gap-[0.35rem] flex-wrap mt-[0.35rem]">
      {tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>
  )}
</article>
