---
import { siteConfig } from "@/config/site";
const currentYear = new Date().getFullYear();
// shared by the four social/feed buttons
const socialBtn =
  "inline-flex size-[34px] items-center justify-center rounded-[8px] border border-border bg-card text-muted-foreground transition-[color,border-color,background-color,translate] duration-150 ease-[ease] hover:-translate-y-[2px] hover:border-link hover:bg-muted hover:text-link";
---

<footer class="mt-auto border-t border-footer-line bg-footer pt-10 pb-12 text-[0.88rem] text-footer-fg">
  <div class="mx-auto w-full max-w-[760px] px-6 flex flex-col items-center gap-4 text-center">
    <div class="flex items-center gap-3" aria-label="Social and feed links">
      {siteConfig.socialLinks.linkedin && (
        <a
          href={siteConfig.socialLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class={socialBtn}
          aria-label="LinkedIn"
          title="Connect on LinkedIn"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      )}

      {siteConfig.socialLinks.github && (
        <a
          href={siteConfig.socialLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          class={socialBtn}
          aria-label="GitHub"
          title="Source on GitHub"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      )}

      {siteConfig.socialLinks.email && (
        <a
          href={
            siteConfig.socialLinks.email.startsWith("http")
              ? siteConfig.socialLinks.email
              : `mailto:${siteConfig.socialLinks.email}`
          }
          target={
            siteConfig.socialLinks.email.startsWith("http")
              ? "_blank"
              : undefined
          }
          rel={
            siteConfig.socialLinks.email.startsWith("http")
              ? "noopener noreferrer"
              : undefined
          }
          class={socialBtn}
          aria-label="Email"
          title="Send an email"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      )}

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class={socialBtn}
        aria-label="RSS Feed"
        title="Subscribe to RSS Feed"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>

    <div>
      © {currentYear} {siteConfig.title}.
    </div>
  </div>
</footer>
