---
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "@/config/site";
import TagBadge from "@/components/TagBadge.svelte";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  timeZone: "UTC",
  year: "numeric",
  month: "short",
  day: "numeric",
});
const showTags = siteConfig.features?.tags !== false;
---

<article class="border-b border-border py-6 last:border-b-0">
  <div class="mb-[0.4rem] flex items-center gap-3 text-[0.82rem] text-muted-foreground">
    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    {showTags && post.data.tags && post.data.tags.length > 0 && (
      <span class="inline-flex flex-wrap items-center gap-[0.35rem]">
        {post.data.tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </span>
    )}
  </div>

  <h2 class="mx-0 mt-0 mb-2 border-b-0 pb-0 text-[1.35rem]">
    <a href={`/blog/${post.id}`} class="text-foreground hover:text-link">
      {post.data.title}
    </a>
  </h2>

  <p class="m-0 text-[0.95rem] leading-[1.6] text-muted-foreground">
    {post.data.description}
  </p>
</article>
