---
import { Font } from "astro:assets";
import { siteConfig } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import BackToTop from "../components/BackToTop.astro";
import ImageZoom from "../components/ImageZoom.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = "/og-image.png",
  wide = false,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? siteConfig.siteUrl,
);
const pageTitle =
  title === siteConfig.title
    ? `${siteConfig.title} — ${siteConfig.tagline}`
    : `${title} | ${siteConfig.title}`;

const features = siteConfig.features ?? {};
const showSearch = features.search !== false;
const showBackToTop = features.backToTop !== false;
const showImageZoom = features.imageZoom !== false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦀</text></svg>"
    />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.title}
      href={new URL("/rss.xml", Astro.site ?? siteConfig.siteUrl)}
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <Font
      cssVariable="--font-fira-sans"
      preload={[{ weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-source-serif"
      preload={[{ weight: 400, style: "normal" }]}
    />
    <Font cssVariable="--font-source-code-pro" />

    <!-- browser chrome color, kept in step with the theme by the script below and ThemeToggle -->
    <meta name="theme-color" content="#f7f4ea" />

    <!-- The page background before the stylesheet arrives, so a page change never shows the
         browser's default canvas first; keep the colors in sync with global.css -->
    <style is:inline>
      html {
        background-color: #f7f4ea;
        color-scheme: light;
      }
      html[data-theme="dark"] {
        background-color: #353535;
        color-scheme: dark;
      }
      @media (prefers-color-scheme: dark) {
        html:not([data-theme]) {
          background-color: #353535;
          color-scheme: dark;
        }
      }
    </style>

    <!-- Set the theme before first paint so the page never flashes the wrong one. The stored
         choice is "paper", "dark", or "auto" (follow the OS); keep in sync with ThemeToggle. -->
    <script is:inline>
      (function () {
        let mode = "auto";
        try {
          mode = localStorage.getItem("rustophile_theme") || "auto";
        } catch {
          // storage blocked: follow the OS
        }
        const dark =
          mode === "dark" ||
          (mode === "auto" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute(
          "data-theme",
          dark ? "dark" : "paper",
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", dark ? "#353535" : "#f7f4ea");
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">
      Skip to content
    </a>
    <Header />
    <main
      id="main-content"
      class:list={[
        "mx-auto w-full flex-1 px-6 pb-14",
        wide ? "max-w-[1080px]" : "max-w-[760px]",
      ]}
    >
      <slot />
    </main>
    <Footer />
    {showSearch && <SearchModal />}
    {showBackToTop && <BackToTop />}
    {showImageZoom && <ImageZoom />}
  </body>
</html>
