---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection("projects");
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 2);

// Aggregate tags with counts
const tagsMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    tagsMap.set(tag, (tagsMap.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagsMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="pt-10 px-0 pb-12 border-b border-line mb-10">
    <h1 class="text-[2.4rem] leading-[1.25] mt-0 mb-4 tracking-[-0.03em]">
      Learning Rust, one borrow at a time.
    </h1>
    <p class="text-[1.15rem] text-muted leading-[1.6] mb-8 max-w-[640px]">
      {siteConfig.tagline}
    </p>
    <div class="flex gap-[0.85rem] flex-wrap">
      <a
        href="/blog"
        class="inline-block py-[0.6rem] px-[1.2rem] text-[0.95rem] font-semibold rounded-md no-underline transition-all duration-200 ease-[ease] bg-accent text-white hover:bg-accent-hover hover:text-white hover:[transform:translateY(-1px)]"
      >
        Read Articles →
      </a>
      <a
        href="/projects"
        class="inline-block py-[0.6rem] px-[1.2rem] text-[0.95rem] font-semibold rounded-md no-underline transition-all duration-200 ease-[ease] bg-surface border border-line text-fg hover:border-accent hover:text-accent hover:[transform:translateY(-1px)]"
      >
        Explore Projects
      </a>
      <a
        href="/about"
        class="inline-block py-[0.6rem] px-[1.2rem] text-[0.95rem] font-semibold rounded-md no-underline transition-all duration-200 ease-[ease] bg-transparent text-muted hover:text-fg"
      >
        About
      </a>
    </div>
  </section>

  <!-- Latest Notes -->
  <section class="mt-12 pt-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="m-0 text-[1.45rem] tracking-[-0.015em]">Latest Articles</h2>
      <a
        href="/blog"
        class="text-[0.9rem] font-medium text-muted no-underline transition-[color] duration-150 ease-[ease] hover:text-accent"
      >
        View all ({allPosts.length}) →
      </a>
    </div>

    <div class="flex flex-col gap-5">
      {recentPosts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="mt-12 pt-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="m-0 text-[1.45rem] tracking-[-0.015em]">
          Featured Projects
        </h2>
        <a
          href="/projects"
          class="text-[0.9rem] font-medium text-muted no-underline transition-[color] duration-150 ease-[ease] hover:text-accent"
        >
          All projects ({allProjects.length}) →
        </a>
      </div>

      <div class="grid grid-cols-[1fr_1fr] gap-5 max-[700px]:grid-cols-[1fr]">
        {featuredProjects.map((proj) => (
          <ProjectCard
            title={proj.data.title}
            description={proj.data.description}
            date={proj.data.date}
            slug={proj.id}
            tags={proj.data.tags}
            stars={proj.data.stars}
            repoUrl={proj.data.repoUrl}
            demoUrl={proj.data.demoUrl}
            category={proj.data.category}
            emoji={proj.data.emoji}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Explore by Topics / Tags Cloud -->
  {siteConfig.features?.tags !== false && topTags.length > 0 && (
    <section class="mt-12 pt-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="m-0 text-[1.45rem] tracking-[-0.015em]">
          Explore by Topics
        </h2>
        <a
          href="/tags"
          class="text-[0.9rem] font-medium text-muted no-underline transition-[color] duration-150 ease-[ease] hover:text-accent"
        >
          All tags ({topTags.length}) →
        </a>
      </div>

      <div class="flex flex-wrap gap-[0.65rem]">
        {topTags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}`}
            class="inline-flex items-center gap-[0.45rem] py-[0.4rem] px-[0.85rem] border border-line rounded-full bg-surface text-fg text-[0.9rem] no-underline transition-[background-color,border-color,color] duration-200 ease-[ease] hover:bg-subtle hover:border-accent hover:text-accent"
          >
            <span class="font-medium">#{tag}</span>
            <span class="text-[0.75rem] font-mono py-[0.1rem] px-[0.4rem] rounded-full bg-subtle text-muted">
              {count}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
