---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you are looking for does not exist."
>
  <div class="flex flex-col items-center justify-center text-center px-4 py-24">
    <div class="font-mono text-[5rem] font-extrabold leading-none text-link mb-4 tracking-[-0.05em]">
      404
    </div>
    <h1 class="mx-0 mt-0 mb-4 text-[2rem] tracking-[-0.02em]">
      Page Not Found
    </h1>
    <p class="max-w-[480px] text-muted-foreground text-[1.1rem] leading-[1.6] mx-0 mt-0 mb-10">
      The page you're looking for has moved, been renamed, or never existed.
    </p>
    <div class="flex gap-4 flex-wrap justify-center">
      <a
        href="/"
        class="inline-flex items-center py-[0.65rem] px-5 bg-primary text-primary-foreground rounded-[6px] font-semibold text-[0.95rem] no-underline transition-opacity duration-200 ease-[ease] hover:opacity-90 hover:text-primary-foreground"
      >
        Return to Home
      </a>
      <a
        href="/blog"
        class="inline-flex items-center py-[0.65rem] px-5 bg-card text-foreground border border-border rounded-[6px] font-semibold text-[0.95rem] no-underline transition-[background-color,border-color] duration-200 ease-[ease] hover:bg-muted hover:border-link"
      >
        Browse All Articles
      </a>
    </div>
  </div>
</BaseLayout>
