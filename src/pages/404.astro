---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you are looking for does not exist."
>
  <div class="flex flex-col items-center justify-center text-center px-4 py-24">
    <div class="font-mono text-[5rem] font-extrabold leading-none text-accent mb-4 tracking-[-0.05em]">
      404
    </div>
    <h1 class="mx-0 mt-0 mb-4 text-[2rem] tracking-[-0.02em]">
      Page Not Found
    </h1>
    <p class="max-w-[480px] text-muted text-[1.1rem] leading-[1.6] mx-0 mt-0 mb-10">
      The note or article you are trying to access has been moved, renamed, or
      no longer exists in this vault.
    </p>
    <div class="flex gap-4 flex-wrap justify-center">
      <a
        href="/"
        class="inline-flex items-center py-[0.65rem] px-5 bg-accent text-white rounded-[6px] font-semibold text-[0.95rem] no-underline transition-opacity duration-200 ease-[ease] hover:opacity-90 hover:text-white"
      >
        Return to Home
      </a>
      <a
        href="/blog"
        class="inline-flex items-center py-[0.65rem] px-5 bg-surface text-fg border border-line rounded-[6px] font-semibold text-[0.95rem] no-underline transition-[background-color,border-color] duration-200 ease-[ease] hover:bg-subtle hover:border-accent"
      >
        Browse All Articles
      </a>
    </div>
  </div>
</BaseLayout>
