---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TOC from "../../components/TOC.astro";
import ShareBar from "../../components/ShareBar.astro";
import CopyCode from "../../components/CopyCode.astro";
import AudioPlayer from "../../components/AudioPlayer.astro";
import StructuredData from "../../components/StructuredData.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Reading time calculation
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMin = Math.max(1, Math.ceil(words / 200));

// Prev / Next posts
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const currentUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;

const features = siteConfig.features ?? {};
const showReadingTime = features.readingTime !== false;
const showTags = features.tags !== false;
const showAudio = features.audioPlayer !== false;
const showShare = features.socialShare !== false;
const showToc = features.tableOfContents !== false && headings.length > 0;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  wide={true}
>
  <StructuredData
    type="article"
    title={post.data.title}
    description={post.data.description}
    datePublished={post.data.pubDate}
    tags={post.data.tags}
    url={currentUrl}
  />

  <div
    class:list={[
      "grid items-start gap-14 pt-4 max-[900px]:gap-8",
      showToc
        ? "grid-cols-[1fr_240px] max-[900px]:grid-cols-[1fr]"
        : "mx-auto my-0 max-w-[780px] grid-cols-[1fr]",
    ]}
  >
    <!-- Main Content Column -->
    <div class="post-main min-w-0">
      <article>
        <header class="post-header mb-8 border-b border-line pb-6">
          <div class="mb-3 flex flex-wrap items-center gap-[0.65rem] text-[0.88rem] text-muted">
            <time datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
            {showReadingTime && (
              <>
                <span class="text-muted opacity-50">·</span>
                <span class="inline-flex items-center gap-[0.35rem]">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {readingMin} min read
                </span>
              </>
            )}
            {showTags && post.data.tags && post.data.tags.length > 0 && (
              <>
                <span class="text-muted opacity-50">·</span>
                <span class="inline-flex flex-wrap items-center gap-[0.35rem]">
                  {post.data.tags.map((tag: string) => (
                    <a
                      href={`/tags/${tag}`}
                      class="inline-flex items-center rounded-sm border border-transparent bg-transparent px-[0.45rem] py-[0.1rem] text-[0.82rem] font-medium text-accent no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-[1.5px] hover:scale-[1.04] hover:border-accent hover:bg-subtle hover:text-accent hover:shadow-[0_2px_8px_rgba(0,0,0,0.08)] active:translate-y-0 active:scale-[0.98]"
                    >
                      #{tag}
                    </a>
                  ))}
                </span>
              </>
            )}
          </div>

          <h1 class="post-title mt-0 mb-3 text-[2.4rem] leading-[1.25] tracking-[-0.025em]">
            {post.data.title}
          </h1>
          <p class="post-description m-0 text-[1.15rem] leading-[1.6] text-muted">
            {post.data.description}
          </p>
        </header>

        <!-- 🔊 Accessible Audio Player (Text-to-Speech) -->
        {showAudio && post.data.audio !== false && (
          <AudioPlayer
            selector=".post-content"
            title={post.data.title}
            label="Listen to Article"
          />
        )}

        {post.data.image && (
          <figure class="post-cover mx-0 my-6">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="cover-img block w-full rounded-lg border border-line"
            />
          </figure>
        )}

        <div class="post-content text-[1.05rem] leading-[1.8]">
          <Content />
        </div>

        {showShare && (
          <ShareBar
            title={post.data.title}
            url={currentUrl}
            description={post.data.description}
          />
        )}

        <!-- Prev / Next Navigation -->
        <nav
          class="mt-10 grid grid-cols-[1fr_1fr] gap-4 border-t border-line pt-6 max-[600px]:grid-cols-[1fr]"
          aria-label="Post navigation"
        >
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}`}
              class="group flex flex-col gap-[0.35rem] rounded-lg border border-line bg-surface p-4 no-underline transition-[border-color,background-color,transform] duration-[0.2s,0.2s,0.15s] ease-[ease] hover:border-accent hover:bg-subtle hover:[transform:translateY(-2px)]"
            >
              <span class="font-mono text-[0.75rem] tracking-[0.05em] text-muted uppercase">
                ← Older
              </span>
              <span class="text-[0.95rem] leading-[1.4] font-medium text-fg group-hover:text-accent">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div class="block"></div>
          )}
          {nextPost ? (
            <a
              href={`/blog/${nextPost.id}`}
              class="group flex flex-col gap-[0.35rem] rounded-lg border border-line bg-surface p-4 no-underline transition-[border-color,background-color,transform] duration-[0.2s,0.2s,0.15s] ease-[ease] hover:border-accent hover:bg-subtle hover:[transform:translateY(-2px)] items-end text-right"
            >
              <span class="font-mono text-[0.75rem] tracking-[0.05em] text-muted uppercase">
                Newer →
              </span>
              <span class="text-[0.95rem] leading-[1.4] font-medium text-fg group-hover:text-accent">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div class="block"></div>
          )}
        </nav>
      </article>
    </div>

    <!-- Sticky Sidebar Column (TOC) -->
    {showToc && (
      <aside
        class="relative h-full max-[900px]:hidden"
        aria-label="Article Table of Contents"
      >
        <TOC headings={headings} title="On This Page" />
      </aside>
    )}
  </div>

  <CopyCode />
</BaseLayout>
