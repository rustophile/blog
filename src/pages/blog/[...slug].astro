---
import Base from "@/layouts/Base.astro";
import ArticleHeader from "@/components/ArticleHeader.astro";
import TOC from "@/components/TOC.astro";
import ShareBar from "@/components/ShareBar.astro";
import Comments from "@/components/Comments.astro";
import AudioPlayer from "@/components/AudioPlayer.astro";
import PostNavigation from "@/components/PostNavigation.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Reading time calculation
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMin = Math.max(1, Math.ceil(words / 200));

// Prev / Next posts
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const currentUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;

const features = siteConfig.features ?? {};
const showAudio = features.audioPlayer !== false;
const showShare = features.socialShare !== false;
const showToc = features.tableOfContents !== false && headings.length > 0;
---

<Base title={post.data.title} description={post.data.description} wide={true}>
  <StructuredData
    type="article"
    title={post.data.title}
    description={post.data.description}
    datePublished={post.data.pubDate}
    tags={post.data.tags}
    url={currentUrl}
  />

  <div
    class:list={[
      "grid items-start gap-14 pt-4 max-[900px]:gap-8",
      showToc
        ? "grid-cols-[1fr_240px] max-[900px]:grid-cols-[1fr]"
        : "mx-auto my-0 max-w-[780px] grid-cols-[1fr]",
    ]}
  >
    <!-- Main Content Column -->
    <div class="post-main min-w-0">
      <article>
        <ArticleHeader
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          readingMinutes={readingMin}
          tags={post.data.tags}
        />

        <!-- 🔊 Accessible Audio Player (Text-to-Speech) -->
        {showAudio && post.data.audio !== false && (
          <AudioPlayer
            selector=".post-content"
            title={post.data.title}
            label="Listen to Article"
          />
        )}

        {post.data.image && (
          <figure class="post-cover mx-0 my-6">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="cover-img block w-full rounded-lg border border-border"
            />
          </figure>
        )}

        <div class="post-content text-[1.05rem] leading-[1.8]">
          <Content />
        </div>

        {showShare && (
          <ShareBar
            title={post.data.title}
            url={currentUrl}
            description={post.data.description}
          />
        )}

        <PostNavigation older={prevPost} newer={nextPost} />

        <Comments />
      </article>
    </div>

    <!-- Sticky Sidebar Column (TOC) -->
    {showToc && (
      <aside
        class="relative h-full max-[900px]:hidden"
        aria-label="Article Table of Contents"
      >
        <TOC headings={headings} title="On This Page" />
      </aside>
    )}
  </div>
</Base>
