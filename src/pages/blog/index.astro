---
import Base from "@/layouts/Base.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ContentFilter from "@/components/ContentFilter.astro";
import PageHeader from "@/components/PageHeader.astro";
import Pagination from "@/components/Pagination.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site";
import TagBadge from "@/components/TagBadge.svelte";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Collect unique tags
const allTags = Array.from(
  new Set(allPosts.flatMap((p) => p.data.tags || [])),
).sort();
const showTags = siteConfig.features?.tags !== false;
---

<Base title="Blog">
  <div class="pt-4">
    <PageHeader
      title="Articles & Notes"
      description="Notes, exercises, and wrong turns from learning Rust."
      size="large"
      descriptionSize="medium"
      descriptionClass="mb-5 leading-[1.6]"
    >
      {showTags && allTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 text-[0.85rem]">
          <span class="font-semibold text-muted-foreground">Topics:</span>
          {allTags.map((tag) => (
            <TagBadge
              tag={tag}
              variant="pill"
              class="px-[0.6rem] py-[0.2rem] text-[0.85rem] text-muted-foreground"
            />
          ))}
        </div>
      )}
    </PageHeader>

    <section class="mt-4">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h2 class="m-0 flex items-center gap-2 text-[1.35rem]">
          <span>All Articles</span>
          <span class="text-[1.1rem] text-muted-foreground">→</span>
        </h2>

        <ContentFilter
          label="Filter articles"
          placeholder="Filter articles..."
          class="min-w-[220px] max-w-[360px]"
        />
      </div>

      <div class="flex flex-col gap-6" id="posts-list">
        {allPosts.map((post) => (
          <div
            class="article-wrapper"
            data-slug={post.id.toLowerCase()}
            data-title={post.data.title.toLowerCase()}
            data-description={post.data.description.toLowerCase()}
            data-tags={post.data.tags.join(" ").toLowerCase()}
          >
            <ArticleCard post={post} />
          </div>
        ))}
      </div>

      <Pagination itemName="Article" />

      <div
        id="no-results"
        class="py-12 text-center text-muted-foreground"
        style="display: none;"
      >
        <p>No articles found matching your filter.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  function setupArticlePagination() {
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const articleWrappers = Array.from(
      document.querySelectorAll<HTMLElement>(".article-wrapper"),
    );
    const noResults = document.getElementById("no-results");

    const bottomContainer = document.getElementById("pagination-bottom");
    const bottomPages = document.getElementById("pagination-pages-bottom");
    const bottomPrev = document.getElementById(
      "page-prev-bottom",
    ) as HTMLButtonElement | null;
    const bottomNext = document.getElementById(
      "page-next-bottom",
    ) as HTMLButtonElement | null;

    const PAGE_SIZE = 4;
    let currentPage = 1;
    let matchingItems: HTMLElement[] = [...articleWrappers];

    function renderPagination() {
      const totalPages = Math.ceil(matchingItems.length / PAGE_SIZE);

      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);
      if (currentPage < 1) currentPage = 1;

      // Hide all items first
      articleWrappers.forEach((el) => (el.style.display = "none"));

      // Show current page slice
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const slice = matchingItems.slice(start, end);
      slice.forEach((el) => (el.style.display = "block"));

      if (noResults) {
        noResults.style.display = matchingItems.length === 0 ? "block" : "none";
      }

      if (totalPages <= 1) {
        if (bottomContainer) bottomContainer.style.display = "none";
        return;
      }

      if (bottomContainer) bottomContainer.style.display = "flex";

      function createPageButtons(targetEl: HTMLElement | null) {
        if (!targetEl) return;
        targetEl.innerHTML = "";
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `pagination-num inline-flex h-[32px] min-w-[32px] cursor-pointer items-center justify-center rounded-[6px] border border-transparent bg-transparent px-[0.45rem] py-0 font-mono text-[0.85rem] text-muted-foreground transition-[background-color,color,border-color] duration-150 ease-[ease] hover:[&:not(.active)]:border-link hover:[&:not(.active)]:bg-muted hover:[&:not(.active)]:text-link [&.active]:cursor-default [&.active]:border-border [&.active]:bg-muted [&.active]:font-semibold [&.active]:text-foreground${i === currentPage ? " active" : ""}`;
          btn.textContent = String(i);
          btn.setAttribute("aria-label", `Page ${i}`);
          btn.addEventListener("click", () => {
            currentPage = i;
            renderPagination();
            window.scrollTo({
              top: document.getElementById("posts-list")?.offsetTop
                ? document.getElementById("posts-list")!.offsetTop - 120
                : 0,
              behavior: "smooth",
            });
          });
          targetEl.appendChild(btn);
        }
      }

      createPageButtons(bottomPages);

      const isFirst = currentPage <= 1;
      const isLast = currentPage >= totalPages;

      if (bottomPrev) bottomPrev.disabled = isFirst;
      if (bottomNext) bottomNext.disabled = isLast;
    }

    function handlePrev() {
      if (currentPage > 1) {
        currentPage--;
        renderPagination();
      }
    }

    function handleNext() {
      const totalPages = Math.ceil(matchingItems.length / PAGE_SIZE);
      if (currentPage < totalPages) {
        currentPage++;
        renderPagination();
      }
    }

    bottomPrev?.addEventListener("click", handlePrev);
    bottomNext?.addEventListener("click", handleNext);

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        matchingItems = articleWrappers.filter((wrapper) => {
          const slug = wrapper.dataset.slug || "";
          const title = wrapper.dataset.title || "";
          const desc = wrapper.dataset.description || "";
          const tags = wrapper.dataset.tags || "";
          return (
            !query ||
            title.includes(query) ||
            desc.includes(query) ||
            tags.includes(query) ||
            slug.includes(query)
          );
        });
        currentPage = 1;
        renderPagination();
      });
    }

    renderPagination();
  }

  setupArticlePagination();
  document.addEventListener("astro:after-swap", setupArticlePagination);
</script>
