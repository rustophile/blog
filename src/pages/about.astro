---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { siteConfig } from "@/config/site";
---

<Base title="About" description={siteConfig.description}>
  <article class="pt-4">
    <PageHeader
      title="About"
      description={siteConfig.tagline}
      margin="compact"
      titleTracking="inherit"
    />

    <div class="text-[1.05rem] leading-[1.8]">
      <p>
        <strong>{siteConfig.title}</strong> is a public notebook for learning
        <a
          href="https://www.rust-lang.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          Rust
        </a>
        : notes on the parts of the language that take more than one read,
        exercises worked through from start to finish, and small projects built
        along the way.
      </p>

      <h2>How this site is built</h2>
      <table>
        <thead>
          <tr>
            <th>Layer</th>
            <th>Technology</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Framework</td>
            <td>
              <a
                href="https://astro.build"
                target="_blank"
                rel="noopener noreferrer"
              >
                Astro
              </a>
            </td>
          </tr>
          <tr>
            <td>Theme</td>
            <td>
              <a
                href="https://github.com/rnt-rez/minrock"
                target="_blank"
                rel="noopener noreferrer"
              >
                Minrock
              </a>{" "}
              by Renato Rezende
            </td>
          </tr>
          <tr>
            <td>Content</td>
            <td>Markdown in content collections</td>
          </tr>
        </tbody>
      </table>

      <p class="text-[0.9rem] text-muted-foreground">
        The R in the site's name is the R from the
        <a
          href="https://github.com/rust-lang/rust-artwork"
          target="_blank"
          rel="noopener noreferrer"
        >
          Rust logo
        </a>
        by the Rust Project, used under
        <a
          href="https://creativecommons.org/licenses/by/4.0/"
          target="_blank"
          rel="noopener noreferrer"
        >
          CC BY 4.0
        </a>
        and shown without its gear. Rust and the Rust logo are trademarks of the
        Rust Foundation; this site is not affiliated with or endorsed by the
        Rust Project or the Rust Foundation.
      </p>
    </div>
  </article>
</Base>
