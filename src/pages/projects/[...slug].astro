---
import Base from "@/layouts/Base.astro";
import AudioPlayer from "@/components/AudioPlayer.astro";
import ProjectHeader from "@/components/ProjectHeader.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const currentUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;
---

<Base title={project.data.title} description={project.data.description}>
  <StructuredData
    type="article"
    title={project.data.title}
    description={project.data.description}
    datePublished={project.data.date}
    tags={project.data.tags}
    url={currentUrl}
  />

  <article class="pt-4">
    <ProjectHeader
      title={project.data.title}
      description={project.data.description}
      date={project.data.date}
      category={project.data.category}
      emoji={project.data.emoji}
      stars={project.data.stars}
      repoUrl={project.data.repoUrl}
      demoUrl={project.data.demoUrl}
    />

    <!-- 🔊 Accessible Audio Player (Text-to-Speech) -->
    {siteConfig.features?.audioPlayer !== false && (
      <AudioPlayer
        selector=".post-content"
        title={project.data.title}
        label="Listen to Project"
      />
    )}

    <div class="post-content text-[1.05rem] leading-[1.8]">
      <Content />
    </div>

    <footer class="mt-14 pt-6 border-t border-border">
      <a
        href="/projects"
        class="text-link no-underline font-medium hover:underline"
      >
        ← Back to all projects
      </a>
    </footer>
  </article>
</Base>
