---
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectsEmpty from "@/components/ProjectsEmpty.svelte";
import ContentFilter from "@/components/ContentFilter.astro";
import PageHeader from "@/components/PageHeader.astro";
import Pagination from "@/components/Pagination.astro";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects")).sort(
  (a, b) =>
    b.data.stars - a.data.stars ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const topProjects = allProjects.filter((p) => p.data.featured).slice(0, 2);
const categories = ["All", ...new Set(allProjects.map((p) => p.data.category))];
---

<Base title="Projects" description="Things built while learning Rust.">
  <div class="pt-4">
    <PageHeader
      title="Projects"
      description="Things built while learning Rust."
      size="large"
      descriptionSize="large"
    />

    {topProjects.length > 0 && (
      <section class="mb-14">
        <h2 class="flex items-center gap-2 text-[1.35rem] mb-5">
          Highlights &amp; Featured
        </h2>
        <div class="grid grid-cols-[1fr_1fr] gap-5 max-[700px]:grid-cols-[1fr]">
          {topProjects.map((proj) => (
            <ProjectCard
              title={proj.data.title}
              description={proj.data.description}
              date={proj.data.date}
              slug={proj.id}
              tags={proj.data.tags}
              stars={proj.data.stars}
              repoUrl={proj.data.repoUrl}
              demoUrl={proj.data.demoUrl}
              category={proj.data.category}
              emoji={proj.data.emoji}
            />
          ))}
        </div>
      </section>
    )}

    {allProjects.length === 0 ? (
      <ProjectsEmpty />
    ) : (
      <section class="mt-8" id="projects-list-section">
        <div class="flex items-center justify-between gap-4 mb-5 flex-wrap">
          <h2 class="flex items-center gap-2 text-[1.35rem] mb-5">
            <span>All Projects</span>
            <span class="text-muted-foreground text-[1.1rem]">→</span>
          </h2>

          <ContentFilter
            label="Filter projects"
            placeholder="Filter projects..."
            class="min-w-[240px] max-w-[400px]"
          />
        </div>

        <!-- Category Filter Pills -->
        <div
          class="flex items-center gap-2 mb-6 flex-wrap"
          role="group"
          aria-label="Filter by category"
        >
          {categories.map((cat) => (
            <button
              type="button"
              class={`filter-btn py-[0.35rem] px-3 text-[0.82rem] font-mono border border-border rounded-full bg-card text-muted-foreground cursor-pointer transition-[background-color,border-color,color] duration-150 ease-[ease] hover:bg-muted hover:border-link hover:text-link hover:font-semibold [&.active]:bg-muted [&.active]:border-link [&.active]:text-link [&.active]:font-semibold${cat === "All" ? " active" : ""}`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Projects List -->
        <div class="flex flex-col gap-5" id="projects-list">
          {allProjects.map((proj) => (
            <div
              class="project-item"
              data-category={proj.data.category}
              data-title={proj.data.title.toLowerCase()}
              data-description={proj.data.description.toLowerCase()}
              data-tags={proj.data.tags.join(" ").toLowerCase()}
            >
              <ProjectCard
                title={proj.data.title}
                description={proj.data.description}
                date={proj.data.date}
                slug={proj.id}
                tags={proj.data.tags}
                stars={proj.data.stars}
                repoUrl={proj.data.repoUrl}
                demoUrl={proj.data.demoUrl}
                category={proj.data.category}
                emoji={proj.data.emoji}
              />
            </div>
          ))}
        </div>

        <Pagination itemName="Projects" />

        <div
          id="no-results"
          class="py-10 px-0 text-center text-muted-foreground"
          style="display: none;"
        >
          <p>No projects found matching your filter.</p>
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  function setupProjectFilters() {
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const filterBtns =
      document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const projectItems = Array.from(
      document.querySelectorAll<HTMLElement>(".project-item"),
    );
    const noResults = document.getElementById("no-results");

    const paginationContainer = document.getElementById("pagination-bottom");
    const paginationPages = document.getElementById("pagination-pages-bottom");
    const pagePrev = document.getElementById(
      "page-prev-bottom",
    ) as HTMLButtonElement | null;
    const pageNext = document.getElementById(
      "page-next-bottom",
    ) as HTMLButtonElement | null;

    const PAGE_SIZE = 3;
    const PAGE_NUM_CLASS =
      "inline-flex items-center justify-center min-w-[32px] h-[32px] py-0 px-[0.45rem] border border-transparent rounded-md bg-transparent text-muted-foreground text-[0.85rem] font-mono cursor-pointer transition-[background-color,color,border-color] duration-150 ease-[ease] hover:[&:not(.active)]:text-link hover:[&:not(.active)]:bg-muted hover:[&:not(.active)]:border-link [&.active]:text-foreground [&.active]:bg-muted [&.active]:font-semibold [&.active]:border-border [&.active]:cursor-default";
    let currentPage = 1;
    let currentCategory = "All";
    let searchQuery = "";
    let matchingItems: HTMLElement[] = [...projectItems];

    function renderPagination() {
      const totalPages = Math.ceil(matchingItems.length / PAGE_SIZE);

      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);
      if (currentPage < 1) currentPage = 1;

      // Hide all items
      projectItems.forEach((it) => (it.style.display = "none"));

      // Show current page slice
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const slice = matchingItems.slice(start, end);
      slice.forEach((it) => (it.style.display = "block"));

      if (noResults) {
        noResults.style.display = matchingItems.length === 0 ? "block" : "none";
      }

      if (totalPages <= 1) {
        if (paginationContainer) paginationContainer.style.display = "none";
        return;
      }

      if (paginationContainer) paginationContainer.style.display = "flex";

      if (paginationPages) {
        paginationPages.innerHTML = "";
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className =
            i === currentPage ? `${PAGE_NUM_CLASS} active` : PAGE_NUM_CLASS;
          btn.textContent = String(i);
          btn.setAttribute("aria-label", `Page ${i}`);
          btn.addEventListener("click", () => {
            currentPage = i;
            renderPagination();
            window.scrollTo({
              top: document.getElementById("projects-list")?.offsetTop
                ? document.getElementById("projects-list")!.offsetTop - 120
                : 0,
              behavior: "smooth",
            });
          });
          paginationPages.appendChild(btn);
        }
      }

      if (pagePrev) pagePrev.disabled = currentPage <= 1;
      if (pageNext) pageNext.disabled = currentPage >= totalPages;
    }

    function applyFilters() {
      const query = searchQuery.trim().toLowerCase();

      matchingItems = projectItems.filter((item) => {
        const cat = item.dataset.category || "";
        const title = item.dataset.title || "";
        const desc = item.dataset.description || "";
        const tags = item.dataset.tags || "";

        const matchesCat = currentCategory === "All" || cat === currentCategory;
        const matchesSearch =
          !query ||
          title.includes(query) ||
          desc.includes(query) ||
          tags.includes(query);
        return matchesCat && matchesSearch;
      });

      currentPage = 1;
      renderPagination();
    }

    pagePrev?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderPagination();
      }
    });

    pageNext?.addEventListener("click", () => {
      const totalPages = Math.ceil(matchingItems.length / PAGE_SIZE);
      if (currentPage < totalPages) {
        currentPage++;
        renderPagination();
      }
    });

    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentCategory = btn.dataset.category || "All";
        applyFilters();
      });
    });

    renderPagination();
  }

  setupProjectFilters();
  document.addEventListener("astro:after-swap", setupProjectFilters);
</script>
