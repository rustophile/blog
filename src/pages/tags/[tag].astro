---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const allProjects = await getCollection("projects");

  const uniqueTags = [
    ...new Set([
      ...allPosts.flatMap((post) => post.data.tags || []),
      ...allProjects.flatMap((proj) => proj.data.tags || []),
    ]),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    const filteredProjects = allProjects
      .filter((proj) => proj.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return {
      params: { tag },
      props: { posts: filteredPosts, projects: filteredProjects, tag },
    };
  });
}

const { posts, projects = [], tag } = Astro.props;
const totalCount = posts.length + projects.length;
---

<BaseLayout
  title={`#${tag}`}
  description={`Browse content tagged with #${tag}`}
>
  <header class="mb-10 pb-6 border-b border-line">
    <div class="flex items-center gap-2 text-[0.88rem] text-muted mb-3">
      <a href="/tags" class="text-accent">
        Tags
      </a>
      <span>/</span>
      <span>#{tag}</span>
    </div>
    <h1 class="text-[2.25rem] mt-0 mb-2 tracking-[-0.025em]">
      Content tagged with <span class="text-accent">#{tag}</span>
    </h1>
    <p class="m-0 text-muted text-[1rem]">
      {totalCount} {totalCount === 1 ? "item" : "items"} found ({posts.length}{" "}
      articles, {projects.length} projects)
    </p>
  </header>

  {posts.length > 0 && (
    <section class="mb-10">
      <h2 class="text-[1.3rem] mb-5 border-b border-line pb-[0.4rem]">
        Articles ({posts.length})
      </h2>
      <div class="flex flex-col">
        {posts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="mb-10">
      <h2 class="text-[1.3rem] mb-5 border-b border-line pb-[0.4rem]">
        Projects ({projects.length})
      </h2>
      <div class="flex flex-col gap-4">
        {projects.map((proj) => (
          <ProjectCard
            title={proj.data.title}
            description={proj.data.description}
            date={proj.data.date}
            slug={proj.id}
            tags={proj.data.tags}
            stars={proj.data.stars}
            repoUrl={proj.data.repoUrl}
            demoUrl={proj.data.demoUrl}
            category={proj.data.category}
            emoji={proj.data.emoji}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
