---
import Base from "@/layouts/Base.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const allProjects = await getCollection("projects");

  const uniqueTags = [
    ...new Set([
      ...allPosts.flatMap((post) => post.data.tags || []),
      ...allProjects.flatMap((proj) => proj.data.tags || []),
    ]),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    const filteredProjects = allProjects
      .filter((proj) => proj.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return {
      params: { tag },
      props: { posts: filteredPosts, projects: filteredProjects, tag },
    };
  });
}

const { posts, projects = [], tag } = Astro.props;
const totalCount = posts.length + projects.length;
const summary = `${totalCount} ${totalCount === 1 ? "item" : "items"} found (${posts.length} articles, ${projects.length} projects)`;
---

<Base title={`#${tag}`} description={`Browse content tagged with #${tag}`}>
  <PageHeader description={summary} descriptionSize="compact">
    <div
      slot="before"
      class="mb-3 flex items-center gap-2 text-[0.88rem] text-muted-foreground"
    >
      <a href="/tags" class="text-link">
        Tags
      </a>
      <span>/</span>
      <span>#{tag}</span>
    </div>
    <Fragment slot="title">
      Content tagged with <span class="text-link">#{tag}</span>
    </Fragment>
  </PageHeader>

  {posts.length > 0 && (
    <section class="mb-10">
      <h2 class="text-[1.3rem] mb-5 border-b border-border pb-[0.4rem]">
        Articles ({posts.length})
      </h2>
      <div class="flex flex-col">
        {posts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="mb-10">
      <h2 class="text-[1.3rem] mb-5 border-b border-border pb-[0.4rem]">
        Projects ({projects.length})
      </h2>
      <div class="flex flex-col gap-4">
        {projects.map((proj) => (
          <ProjectCard
            title={proj.data.title}
            description={proj.data.description}
            date={proj.data.date}
            slug={proj.id}
            tags={proj.data.tags}
            stars={proj.data.stars}
            repoUrl={proj.data.repoUrl}
            demoUrl={proj.data.demoUrl}
            category={proj.data.category}
            emoji={proj.data.emoji}
          />
        ))}
      </div>
    </section>
  )}
</Base>
