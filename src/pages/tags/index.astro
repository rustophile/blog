---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getCollection } from "astro:content";
import TagBadge from "@/components/TagBadge.svelte";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const projects = await getCollection("projects");

// Aggregate tags with counts across both blog articles and projects
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
projects.forEach((proj) => {
  proj.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base title="Tags" description="Explore articles by topic and tag.">
  <PageHeader
    title="Explore by Tag"
    description="Browse notes and articles grouped by topics."
  />

  <div class="flex flex-wrap gap-3 py-4">
    {sortedTags.map(([tag, count]) => (
      <TagBadge tag={tag} variant="pill" count={count} />
    ))}
  </div>
</Base>
