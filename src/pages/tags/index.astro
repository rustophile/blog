---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const projects = await getCollection("projects");

// Aggregate tags with counts across both blog articles and projects
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
projects.forEach((proj) => {
  proj.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags" description="Explore articles by topic and tag.">
  <header class="mb-10 pb-6 border-b border-border">
    <h1 class="text-[2.25rem] mt-0 mb-2 tracking-[-0.025em]">Explore by Tag</h1>
    <p class="m-0 text-[1.1rem] text-muted-foreground">
      Browse notes and articles grouped by topics.
    </p>
  </header>

  <div class="flex flex-wrap gap-3 py-4">
    {sortedTags.map(([tag, count]) => (
      <a
        href={`/tags/${tag}`}
        class="inline-flex items-center gap-2 py-2 px-4 bg-card border border-border rounded-[9999px] text-[0.95rem] text-foreground no-underline transition-[background-color,border-color,color] duration-200 ease-[ease] hover:bg-muted hover:border-link hover:text-link"
      >
        <span class="font-semibold">#{tag}</span>
        <span class="text-[0.8rem] text-muted-foreground bg-muted py-[0.15rem] px-[0.45rem] rounded-[9999px]">
          {count}
        </span>
      </a>
    ))}
  </div>
</BaseLayout>
