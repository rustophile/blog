---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import TagBadge from "../../components/TagBadge.svelte";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const projects = await getCollection("projects");

// Aggregate tags with counts across both blog articles and projects
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
projects.forEach((proj) => {
  proj.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags" description="Explore articles by topic and tag.">
  <header class="mb-10 pb-6 border-b border-border">
    <h1 class="text-[2.25rem] mt-0 mb-2 tracking-[-0.025em]">Explore by Tag</h1>
    <p class="m-0 text-[1.1rem] text-muted-foreground">
      Browse notes and articles grouped by topics.
    </p>
  </header>

  <div class="flex flex-wrap gap-3 py-4">
    {sortedTags.map(([tag, count]) => (
      <TagBadge tag={tag} variant="pill" count={count} />
    ))}
  </div>
</BaseLayout>
