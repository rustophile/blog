{
  "name": "rustdoc Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#2a2a2a",
    "editor.foreground": "#dddddd"
  },
  "tokenColors": [
    {
      "name": "rustdoc colors few tokens: everything not listed below (types, functions, variables, operators, paths) stays plain",
      "scope": [
        "source",
        "variable",
        "entity.name",
        "support",
        "keyword.operator",
        "punctuation",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#dddddd"
      }
    },
    {
      "name": "comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8d8d8b"
      }
    },
    {
      "name": "doccomment",
      "scope": [
        "comment.line.documentation",
        "comment.block.documentation",
        "comment.line.documentation punctuation.definition.comment",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8ca375"
      }
    },
    {
      "name": "kw",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.declaration",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ab8ac1"
      }
    },
    {
      "name": "operators stay plain",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#dddddd"
      }
    },
    {
      "name": "kw-2: & (rustdoc's ref keyword)",
      "scope": ["keyword.operator.borrow"],
      "settings": {
        "foreground": "#769acb"
      }
    },
    {
      "name": "prelude-val: Some, None, Ok, Err",
      "scope": ["entity.name.type.option", "entity.name.type.result"],
      "settings": {
        "foreground": "#ee6868"
      }
    },
    {
      "name": "self, Self, true, false",
      "scope": [
        "variable.language.self",
        "variable.language",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ee6868"
      }
    },
    {
      "name": "attr: the whole #[...] (literals inside keep their own color)",
      "scope": [
        "meta.attribute",
        "meta.attribute entity.name.type",
        "meta.attribute punctuation",
        "meta.attribute variable",
        "meta.attribute keyword.operator"
      ],
      "settings": {
        "foreground": "#ee6868"
      }
    },
    {
      "name": "string and number, placeholders included",
      "scope": [
        "string",
        "string meta.interpolation",
        "string punctuation",
        "constant.numeric",
        "constant.character",
        "constant.numeric punctuation"
      ],
      "settings": {
        "foreground": "#83a300"
      }
    },
    {
      "name": "macro",
      "scope": ["entity.name.function.macro", "support.function.macro"],
      "settings": {
        "foreground": "#3e999f"
      }
    },
    {
      "name": "lifetime",
      "scope": ["entity.name.type.lifetime", "punctuation.definition.lifetime"],
      "settings": {
        "foreground": "#d97f26"
      }
    },
    {
      "name": "question-mark (bold, as rustdoc draws it)",
      "scope": ["keyword.operator.question"],
      "settings": {
        "foreground": "#ff9011",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Other languages (TOML, shell) get rustdoc's string and keyword colors for keys and commands",
      "scope": [
        "support.type.property-name",
        "entity.name.tag",
        "entity.name.command"
      ],
      "settings": {
        "foreground": "#769acb"
      }
    },
    {
      "name": "rustc diagnostics (```rustc): colored as rustc colors its terminal output, in this palette",
      "scope": ["keyword.other.error.rustc", "markup.label.primary.rustc"],
      "settings": {
        "foreground": "#ee6868",
        "fontStyle": "bold"
      }
    },
    {
      "name": "rustc: warnings",
      "scope": ["keyword.other.warning.rustc"],
      "settings": {
        "foreground": "#d2991d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "rustc: gutter, -->, = and secondary labels",
      "scope": ["punctuation.gutter.rustc", "markup.label.secondary.rustc"],
      "settings": {
        "foreground": "#769acb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "rustc: the message, note: and the closing hint",
      "scope": ["markup.bold.message.rustc", "keyword.other.note.rustc"],
      "settings": {
        "foreground": "#dddddd",
        "fontStyle": "bold"
      }
    },
    {
      "name": "rustc: help:",
      "scope": ["keyword.other.help.rustc"],
      "settings": {
        "foreground": "#3e999f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "rustc: file paths",
      "scope": ["string.unquoted.path.rustc"],
      "settings": {
        "foreground": "#dddddd"
      }
    },
    {
      "name": "rustc: suggestion markers (+++)",
      "scope": ["markup.inserted.suggestion.rustc"],
      "settings": {
        "foreground": "#83a300",
        "fontStyle": "bold"
      }
    }
  ]
}
