# Cloudflare static-asset headers: https://developers.cloudflare.com/workers/static-assets/headers/
# Astro's build output in /_astro/ (CSS, JS, fonts) has content-hashed filenames,
# so a changed file always gets a new URL and these can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
